{
  "name": "mdpabel-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:bun": "bunx --bun astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "gen": "node scripts/process-threats.mjs",
    "validate:research": "node scripts/validate-malware-research.mjs",
    "validate:research:rendered": "node scripts/validate-rendered-malware-research.mjs",
    "sync": "npx tsx scripts/sync-content.ts",
    "build:prod": "npm run sync && npm run build:astro",
    "fetch:posts": "node scripts/fetch-one-by-one.js --type=posts",
    "fetch:cases": "node scripts/fetch-one-by-one.js --type=case-study",
    "fetch:guides": "node scripts/fetch-one-by-one.js --type=guide",
    "fetch:logs": "node scripts/fetch-one-by-one.js --type=malware-log",
    "fetch:all": "npm run fetch:posts && npm run fetch:cases && npm run fetch:guides && npm run fetch:logs",
    "fetch:all:force": "node scripts/fetch-one-by-one.js --type=posts --force=true && node scripts/fetch-one-by-one.js --type=case-study --force=true && node scripts/fetch-one-by-one.js --type=guide --force=true && node scripts/fetch-one-by-one.js --type=malware-log --force=true",
    "build:fetchAll": "npm run fetch:all && npm run build:astro",
    "build:astro": "node --require ./scripts/limit-astro-image-concurrency.cjs ./node_modules/astro/astro.js build",
    "build": "npm run build:astro && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.15",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@lucide/astro": "^0.562.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/sanitize-html": "^2.16.0",
    "astro": "^5.16.11",
    "astro-critters": "^2.2.1",
    "axios": "^1.13.4",
    "cheerio": "^1.2.0",
    "lru-cache": "^11.2.5",
    "p-limit": "^7.3.0",
    "sanitize-html": "^2.17.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/turndown": "^5.0.6",
    "dotenv": "^17.2.3",
    "openai": "^6.16.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
