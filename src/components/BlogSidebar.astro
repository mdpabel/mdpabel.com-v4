---
import { Image } from 'astro:assets';
import { ArrowRight, ShieldCheck, Siren } from '@lucide/astro';
import type { WordPressPost } from '../lib/wordpress';
import { siteData } from '../data/siteData';
import me from '../assets/my-img.png';

interface Props {
  relatedPosts?: WordPressPost[];
}

const { relatedPosts = [] } = Astro.props;
---

<aside class='space-y-5 lg:sticky lg:top-24 lg:self-start' aria-label='Article sidebar'>
  <section
    class='overflow-hidden rounded-xl border border-slate-700/80 bg-slate-950/65 shadow-lg shadow-black/10'
    aria-labelledby='sidebar-author-heading'>
    <div class='h-16 bg-gradient-to-r from-sky-500/25 via-emerald-500/15 to-slate-900'></div>
    <div class='px-5 pb-5'>
      <a
        href='/about/'
        class='-mt-8 block w-fit rounded-full border-4 border-slate-950'
        aria-label='Learn more about MD Pabel'>
        <Image
          src={me}
          alt='MD Pabel, WordPress malware removal expert'
          width={72}
          height={72}
          format='avif'
          quality='mid'
          loading='lazy'
          class='rounded-full object-cover'
        />
      </a>

      <h2 id='sidebar-author-heading' class='mt-3 text-xl font-bold text-white'>
        <a href='/about/' class='transition-colors hover:text-emerald-400'>MD Pabel</a>
      </h2>
      <p class='mt-1 text-sm font-medium text-emerald-400'>
        WordPress Malware Removal Expert
      </p>
      <p class='mt-3 text-sm leading-6 text-slate-300'>
        Helping website owners recover hacked WordPress sites, remove security
        warnings, and prevent reinfection for {siteData.stats.experience}.
      </p>
      <a
        href='/hire-me/'
        class='mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-emerald-500'>
        Work with me
        <ArrowRight class='h-4 w-4' />
      </a>
    </div>
  </section>

  <section
    class='rounded-xl border border-slate-700/80 bg-slate-950/65 p-5'
    aria-labelledby='sidebar-services-heading'>
    <h2 id='sidebar-services-heading' class='text-lg font-bold text-white'>
      Website security services
    </h2>
    <div class='mt-3 divide-y divide-slate-800'>
      <a
        href='/wordpress-malware-removal/'
        class='group flex gap-3 py-4 first:pt-2 last:pb-0'>
        <span class='mt-0.5 rounded-lg bg-emerald-500/10 p-2 text-emerald-400'>
          <Siren class='h-5 w-5' />
        </span>
        <span>
          <span class='block font-semibold text-slate-100 transition-colors group-hover:text-emerald-400'>
            Malware removal
          </span>
          <span class='mt-1 block text-xs leading-5 text-slate-400'>
            Clean malware, backdoors, redirects, and SEO spam.
          </span>
        </span>
      </a>

      <a href='/blacklist-removal/' class='group flex gap-3 py-4 first:pt-2 last:pb-0'>
        <span class='mt-0.5 rounded-lg bg-sky-500/10 p-2 text-sky-400'>
          <ShieldCheck class='h-5 w-5' />
        </span>
        <span>
          <span class='block font-semibold text-slate-100 transition-colors group-hover:text-sky-400'>
            Blacklist removal
          </span>
          <span class='mt-1 block text-xs leading-5 text-slate-400'>
            Clear browser warnings and restore your site reputation.
          </span>
        </span>
      </a>
    </div>
  </section>

  {
    relatedPosts.length > 0 && (
      <section
        class='rounded-xl border border-slate-700/80 bg-slate-950/65 p-5'
        aria-labelledby='sidebar-related-heading'>
        <h2 id='sidebar-related-heading' class='text-lg font-bold text-white'>
          Related posts
        </h2>
        <div class='mt-3 divide-y divide-slate-800'>
          {relatedPosts.map((post) => (
            <a
              href={`/blog/${post.slug}/`}
              class='group grid grid-cols-[4.5rem_1fr] gap-3 py-4 first:pt-1 last:pb-0'>
              <div class='aspect-[4/3] overflow-hidden rounded-lg bg-slate-800'>
                {post.featuredImage ? (
                  <img
                    src={post.featuredImage.url}
                    alt=''
                    width='144'
                    height='108'
                    class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105'
                    loading='lazy'
                  />
                ) : (
                  <div class='flex h-full items-center justify-center text-xs font-bold text-slate-500'>
                    MD
                  </div>
                )}
              </div>
              <span>
                <span
                  class='line-clamp-3 block text-sm font-semibold leading-5 text-slate-200 transition-colors group-hover:text-sky-400'
                  set:html={post.title}
                />
                <time class='mt-1 block text-xs text-slate-500'>
                  {new Date(post.date).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</aside>
