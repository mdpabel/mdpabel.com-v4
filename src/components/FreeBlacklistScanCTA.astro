---
import ComponentWrapper from './component-wrapper.astro';
import { ShieldAlert, ArrowRight } from '@lucide/astro';

const primaryHref = '/free-wordpress-blacklist-scan/';
---

<ComponentWrapper class='py-8 md:py-10'>
  <section
    class='flex md:flex-row flex-col md:justify-between md:items-center gap-5 bg-slate-900/70 p-6 md:p-7 border border-emerald-500/20 rounded-2xl'>
    <div class='flex items-start gap-4'>
      <div
        class='flex justify-center items-center bg-emerald-500/10 border border-emerald-500/20 rounded-xl w-11 h-11 shrink-0'>
        <ShieldAlert class='w-5 h-5 text-emerald-400' />
      </div>

      <div>
        <h2 class='mb-1 font-bold text-white text-xl md:text-2xl'>
          Free WordPress Blacklist Scan
        </h2>

        <p
          class='max-w-2xl text-slate-400 text-sm md:text-base leading-relaxed'>
          Check if your WordPress site is blacklisted by Google Safe Browsing,
          Chrome, McAfee, Norton, Avast, Quttera, or other security vendors.
        </p>
      </div>
    </div>

    <a
      href={primaryHref}
      class='inline-flex justify-center items-center gap-2 bg-emerald-500 hover:bg-emerald-400 px-5 py-2.5 rounded-full font-semibold text-slate-950 text-sm transition-all shrink-0'>
      Check My Site Free
      <ArrowRight class='w-4 h-4' />
    </a>
  </section>
</ComponentWrapper>
