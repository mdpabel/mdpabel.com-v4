---
import { ArrowRight, BookOpenCheck } from '@lucide/astro';
---

<aside
  aria-label='Free WordPress security course'
  class='mb-10 rounded-2xl border border-sky-500/25 bg-sky-500/10 p-6 md:flex md:items-center md:justify-between md:gap-8'>
  <div class='flex items-start gap-4'>
    <span
      class='flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-sky-400/20 bg-sky-400/10 text-sky-300'>
      <BookOpenCheck class='h-5 w-5' aria-hidden='true' />
    </span>
    <div>
      <p class='font-sans text-xs font-bold uppercase tracking-[0.16em] text-sky-300'>
        Free self-paced course
      </p>
      <h2 class='mt-1 text-xl font-bold text-white'>
        WordPress security lessons for site owners
      </h2>
      <p class='mt-2 max-w-2xl text-sm leading-relaxed text-slate-300'>
        Follow eight beginner-friendly lessons on access, software, backups,
        hardening, early detection, and recovery. Save progress in your browser.
      </p>
    </div>
  </div>
  <a
    href='/free-wordpress-security-course/'
    class='mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-sky-400 px-5 py-2.5 font-sans text-sm font-bold text-slate-950 transition-colors hover:bg-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white md:mt-0 md:shrink-0'>
    Start the free course
    <ArrowRight class='h-4 w-4' aria-hidden='true' />
  </a>
</aside>
