---
import { ArrowRight, CircleCheck, Clock3 } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { getLessonPath } from '../../data/course';

interface Props {
  lesson: CollectionEntry<'wordpressSecurityCourse'>;
}

const { lesson } = Astro.props;
const { data } = lesson;
---

<article
  class='group flex h-full flex-col rounded-2xl border border-slate-700 bg-slate-900/60 p-5 transition-colors hover:border-sky-500/50 data-[complete=true]:border-emerald-500/40'
  data-course-lesson
  data-lesson-slug={data.slug}
  data-complete='false'>
  <div class='mb-4 flex items-center justify-between gap-3'>
    <span
      class='rounded-full bg-sky-400/10 px-3 py-1 font-sans text-xs font-bold text-sky-300'>
      Lesson {data.lessonNumber}
    </span>
    <span class='inline-flex items-center gap-1.5 text-xs text-slate-400'>
      <Clock3 class='h-4 w-4' aria-hidden='true' />
      {data.readingTime} min
    </span>
  </div>

  <h3 class='text-xl font-bold leading-snug text-white'>
    <a
      href={getLessonPath(data.slug)}
      class='rounded-sm hover:text-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400'>
      {data.shortTitle}
    </a>
  </h3>
  <p class='mt-3 grow text-sm leading-relaxed text-slate-400'>
    {data.description}
  </p>

  <div class='mt-5 flex items-center justify-between border-t border-slate-800 pt-4'>
    <span class='inline-flex items-center gap-1.5 text-xs text-slate-500'>
      <CircleCheck class='h-4 w-4' aria-hidden='true' />
      <span data-course-lesson-status>Not complete</span>
    </span>
    <span class='inline-flex items-center gap-1 text-sm font-semibold text-sky-300'>
      Start lesson
      <ArrowRight
        class='h-4 w-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none'
        aria-hidden='true'
      />
    </span>
  </div>
</article>
