---
import {
  ArrowLeft,
  ArrowRight,
  BookOpen,
  CircleCheck,
  Clock3,
  ExternalLink,
  ListChecks,
  ShieldCheck,
  TriangleAlert,
} from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import ComponentWrapper from '../component-wrapper.astro';
import Layout from '../../layouts/Layout.astro';
import {
  COURSE_BASE,
  courseMeta,
  getLessonPath,
} from '../../data/course';
import CourseBreadcrumbs from './CourseBreadcrumbs.astro';
import CourseProgress from './CourseProgress.astro';

interface Props {
  lesson: CollectionEntry<'wordpressSecurityCourse'>;
  lessons: CollectionEntry<'wordpressSecurityCourse'>[];
}

const { lesson, lessons } = Astro.props;
const { data } = lesson;
const canonical = new URL(getLessonPath(data.slug), Astro.site).href;
const courseCanonical = new URL(COURSE_BASE, Astro.site).href;
const lessonSlugs = lessons.map((item) => item.data.slug);

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: data.title,
      description: data.description,
      inLanguage: 'en',
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      mainEntity: { '@id': `${canonical}#lesson` },
      isPartOf: { '@id': `${courseCanonical}#course` },
    },
    {
      '@type': 'LearningResource',
      '@id': `${canonical}#lesson`,
      url: canonical,
      name: data.title,
      headline: data.title,
      description: data.description,
      inLanguage: 'en',
      learningResourceType: 'Lesson',
      educationalLevel: 'Beginner',
      position: data.lessonNumber,
      timeRequired: `PT${data.readingTime}M`,
      author: {
        '@type': 'Person',
        name: 'MD Pabel',
        url: 'https://www.mdpabel.com/about/',
      },
      isPartOf: {
        '@type': 'Course',
        '@id': `${courseCanonical}#course`,
        name: courseMeta.title,
        url: courseCanonical,
        isAccessibleForFree: true,
        provider: {
          '@type': 'Person',
          name: 'MD Pabel',
          url: 'https://www.mdpabel.com/about/',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.mdpabel.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: courseMeta.title,
          item: courseCanonical,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: data.shortTitle,
          item: canonical,
        },
      ],
    },
  ],
});
---

<Layout
  title={data.title}
  description={data.description}
  socialTitle={data.title}
  socialDescription={data.socialDescription}
  image={courseMeta.image}
  canonical={canonical}>
  <script is:inline type='application/ld+json' set:html={structuredData} />

  <ComponentWrapper class='py-10 md:py-14'>
    <CourseBreadcrumbs
      items={[
        { label: 'Free WordPress security course', href: COURSE_BASE },
        { label: `Lesson ${data.lessonNumber}` },
      ]}
    />

    <div class='grid gap-10 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start'>
      <article class='min-w-0'>
        <header class='border-b border-slate-800 pb-8'>
          <div class='mb-5 flex flex-wrap items-center gap-3 font-sans text-sm'>
            <span
              class='rounded-full bg-sky-400/10 px-3 py-1 font-bold text-sky-300'>
              Lesson {data.lessonNumber} of {lessons.length}
            </span>
            <span class='inline-flex items-center gap-1.5 text-slate-400'>
              <Clock3 class='h-4 w-4' aria-hidden='true' />
              {data.readingTime} minute read
            </span>
          </div>
          <h1 class='max-w-4xl text-4xl font-extrabold leading-tight text-white md:text-5xl'>
            {data.title}
          </h1>
          <p class='mt-5 max-w-3xl text-lg leading-relaxed text-slate-300 md:text-xl'>
            {data.description}
          </p>
        </header>

        <section
          aria-labelledby='objectives-heading'
          class='my-8 rounded-2xl border border-sky-500/20 bg-sky-500/10 p-6'>
          <div class='flex items-center gap-3'>
            <BookOpen class='h-5 w-5 text-sky-300' aria-hidden='true' />
            <h2 id='objectives-heading' class='text-xl font-bold text-white'>
              What you will learn
            </h2>
          </div>
          <ul class='mt-4 space-y-3'>
            {
              data.objectives.map((objective) => (
                <li class='flex items-start gap-3 text-slate-300'>
                  <CircleCheck
                    class='mt-0.5 h-5 w-5 shrink-0 text-sky-300'
                    aria-hidden='true'
                  />
                  <span>{objective}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <div
          class='course-markdown prose prose-lg max-w-none prose-invert prose-headings:scroll-mt-28 prose-headings:font-bold prose-headings:text-white prose-p:leading-relaxed prose-p:text-slate-300 prose-a:font-semibold prose-a:text-sky-300 prose-a:underline-offset-4 hover:prose-a:text-sky-200 prose-strong:text-white prose-code:break-words prose-code:text-pink-300 prose-pre:max-w-full prose-pre:overflow-x-auto prose-pre:border prose-pre:border-slate-700 prose-pre:bg-slate-950 prose-img:h-auto prose-img:max-w-full prose-img:rounded-xl prose-img:border prose-img:border-slate-700 prose-li:text-slate-300'>
          <slot />
        </div>

        <section
          aria-labelledby='action-heading'
          class='my-10 rounded-2xl border border-emerald-500/25 bg-emerald-500/10 p-6 md:p-8'>
          <div class='flex items-center gap-3'>
            <ShieldCheck class='h-6 w-6 text-emerald-300' aria-hidden='true' />
            <h2 id='action-heading' class='text-2xl font-bold text-white'>
              Do this now: {data.action.title}
            </h2>
          </div>
          <p class='mt-4 leading-relaxed text-slate-300'>
            {data.action.introduction}
          </p>
          <ol class='mt-5 space-y-3'>
            {
              data.action.steps.map((step, index) => (
                <li class='flex items-start gap-3 text-slate-200'>
                  <span class='flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-emerald-400 font-sans text-sm font-bold text-slate-950'>
                    {index + 1}
                  </span>
                  <span class='pt-0.5'>{step}</span>
                </li>
              ))
            }
          </ol>
        </section>

        <div class='my-10 grid gap-6 md:grid-cols-2'>
          <section
            aria-labelledby='mistakes-heading'
            class='rounded-2xl border border-amber-500/20 bg-amber-500/10 p-6'>
            <div class='flex items-center gap-3'>
              <TriangleAlert class='h-5 w-5 text-amber-300' aria-hidden='true' />
              <h2 id='mistakes-heading' class='text-xl font-bold text-white'>
                Common mistakes
              </h2>
            </div>
            <ul class='mt-4 space-y-3'>
              {
                data.commonMistakes.map((mistake) => (
                  <li class='flex gap-3 text-sm leading-relaxed text-slate-300'>
                    <span class='mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-300' />
                    <span>{mistake}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section
            aria-labelledby='checklist-heading'
            class='rounded-2xl border border-slate-700 bg-slate-900/70 p-6'>
            <div class='flex items-center gap-3'>
              <ListChecks class='h-5 w-5 text-sky-300' aria-hidden='true' />
              <h2 id='checklist-heading' class='text-xl font-bold text-white'>
                Lesson checklist
              </h2>
            </div>
            <ul class='mt-4 space-y-3'>
              {
                data.checklist.map((item) => (
                  <li class='flex gap-3 text-sm leading-relaxed text-slate-300'>
                    <span class='mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded border border-slate-600' aria-hidden='true' />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <section aria-labelledby='further-reading-heading' class='my-10'>
          <h2 id='further-reading-heading' class='text-2xl font-bold text-white'>
            Further reading
          </h2>
          <p class='mt-2 text-slate-400'>
            These verified resources from this site go deeper without repeating
            the whole lesson.
          </p>
          <div class='mt-5 grid gap-4 sm:grid-cols-2'>
            {
              data.furtherReading.map((link) => (
                <a
                  href={link.href}
                  class='group rounded-xl border border-slate-700 bg-slate-900/60 p-5 transition-colors hover:border-sky-500/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400'>
                  <span class='flex items-start justify-between gap-3 font-bold text-white group-hover:text-sky-300'>
                    {link.label}
                    <ExternalLink
                      class='mt-1 h-4 w-4 shrink-0'
                      aria-hidden='true'
                    />
                  </span>
                  <span class='mt-2 block text-sm leading-relaxed text-slate-400'>
                    {link.description}
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <aside class='my-10 rounded-2xl border border-slate-700 bg-slate-950/60 p-6'>
          <h2 class='text-xl font-bold text-white'>Need a second opinion?</h2>
          <p class='mt-2 max-w-2xl text-sm leading-relaxed text-slate-300'>
            Use the free WordPress scan for an initial check. If the site is
            already redirecting, showing warnings, or creating unknown users,
            review the malware-removal service instead of making random changes.
          </p>
          <div class='mt-5 flex flex-col gap-3 sm:flex-row'>
            <a
              href='/free-wordpress-scan/'
              class='inline-flex items-center justify-center rounded-full bg-emerald-400 px-5 py-2.5 font-sans text-sm font-bold text-slate-950 hover:bg-emerald-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300'>
              Run the free WordPress scan
            </a>
            <a
              href='/wordpress-malware-removal/'
              class='inline-flex items-center justify-center rounded-full border border-slate-600 px-5 py-2.5 font-sans text-sm font-bold text-white hover:border-sky-400 hover:text-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400'>
              Review malware-removal help
            </a>
          </div>
        </aside>

        <nav
          aria-label='Lesson navigation'
          class='grid gap-4 border-t border-slate-800 pt-8 sm:grid-cols-2'>
          {
            data.previousLesson ? (
              <a
                href={getLessonPath(data.previousLesson.slug)}
                class='group rounded-xl border border-slate-700 bg-slate-900/60 p-5 hover:border-sky-500/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400'>
                <span class='flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-[0.16em] text-slate-500'>
                  <ArrowLeft class='h-4 w-4' aria-hidden='true' /> Previous lesson
                </span>
                <span class='mt-2 block font-bold text-white group-hover:text-sky-300'>
                  {data.previousLesson.label}
                </span>
              </a>
            ) : (
              <a
                href={COURSE_BASE}
                class='group rounded-xl border border-slate-700 bg-slate-900/60 p-5 hover:border-sky-500/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400'>
                <span class='flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-[0.16em] text-slate-500'>
                  <ArrowLeft class='h-4 w-4' aria-hidden='true' /> Course hub
                </span>
                <span class='mt-2 block font-bold text-white group-hover:text-sky-300'>
                  View the full curriculum
                </span>
              </a>
            )
          }
          {
            data.nextLesson ? (
              <a
                href={getLessonPath(data.nextLesson.slug)}
                class='group rounded-xl border border-slate-700 bg-slate-900/60 p-5 text-left hover:border-sky-500/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400 sm:text-right'>
                <span class='flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-[0.16em] text-slate-500 sm:justify-end'>
                  Next lesson <ArrowRight class='h-4 w-4' aria-hidden='true' />
                </span>
                <span class='mt-2 block font-bold text-white group-hover:text-sky-300'>
                  {data.nextLesson.label}
                </span>
              </a>
            ) : (
              <a
                href={`${COURSE_BASE}#final-checklist`}
                class='group rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-5 text-left hover:border-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 sm:text-right'>
                <span class='flex items-center gap-2 font-sans text-xs font-bold uppercase tracking-[0.16em] text-emerald-300 sm:justify-end'>
                  Course complete <ArrowRight class='h-4 w-4' aria-hidden='true' />
                </span>
                <span class='mt-2 block font-bold text-white'>
                  Open the printable final checklist
                </span>
              </a>
            )
          }
        </nav>

        <p class='mt-6 text-center text-sm text-slate-500'>
          <a
            href={COURSE_BASE}
            class='rounded-sm underline underline-offset-4 hover:text-sky-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400'>
            Back to the course hub
          </a>
        </p>
      </article>

      <aside class='space-y-6 lg:sticky lg:top-28'>
        <CourseProgress lessonSlugs={lessonSlugs} currentSlug={data.slug} />

        <nav
          aria-label='Course lessons'
          class='rounded-2xl border border-slate-800 bg-slate-950/40 p-4'>
          <p class='px-2 font-sans text-xs font-bold uppercase tracking-[0.16em] text-slate-500'>
            Course lessons
          </p>
          <ol class='mt-3 space-y-1'>
            {
              lessons.map((item) => (
                <li>
                  <a
                    href={getLessonPath(item.data.slug)}
                    aria-current={
                      item.data.slug === data.slug ? 'page' : undefined
                    }
                    class:list={[
                      'flex items-start gap-3 rounded-lg px-3 py-2.5 text-sm leading-snug focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-400',
                      item.data.slug === data.slug
                        ? 'bg-sky-400/10 font-semibold text-sky-300'
                        : 'text-slate-400 hover:bg-slate-800/60 hover:text-white',
                    ]}>
                    <span class='font-sans text-xs font-bold text-slate-600'>
                      {String(item.data.lessonNumber).padStart(2, '0')}
                    </span>
                    <span>{item.data.shortTitle}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>
    </div>
  </ComponentWrapper>
</Layout>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global([data-course-progress]),
    article > aside,
    article > nav,
    article + aside {
      display: none !important;
    }

    :global(body),
    :global(main),
    article {
      background: white !important;
      color: black !important;
    }
  }
</style>
