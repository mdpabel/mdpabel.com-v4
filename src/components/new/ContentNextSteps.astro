---
import { ArrowRight, BookOpen, ScanLine, ShieldCheck } from '@lucide/astro';

interface Props {
  context: 'blog' | 'case-studies' | 'guides';
  placement: 'sidebar' | 'inline';
}

const { context, placement } = Astro.props;
const titleId = `content-next-steps-${context}-${placement}`;
const heading = context === 'case-studies'
  ? 'Need the same kind of problem investigated?'
  : context === 'guides'
    ? 'Would you rather have an expert handle it?'
    : 'Need help applying this to your site?';
---

<section
  class:list={[
    'overflow-hidden rounded-2xl border border-[#cbd6cf] bg-[#fffdf8]',
    placement === 'inline' && 'mt-14',
  ]}
  aria-labelledby={titleId}
>
  <div class:list={['bg-[#17352c] text-white', placement === 'sidebar' ? 'p-5' : 'p-6 sm:p-8']}>
    <p class='flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#8ed0b5]'>
      <ShieldCheck class='h-4 w-4' /> Practical next steps
    </p>
    <h2 id={titleId} class:list={['editorial-heading mt-3 font-semibold', placement === 'sidebar' ? 'text-2xl' : 'text-3xl']}>
      {heading}
    </h2>
    <p class='mt-3 text-sm leading-6 text-[#c8d8d1]'>
      Choose the level of help that fits where you are now. Start with professional cleanup, request a preliminary scan, or learn the process yourself.
    </p>
    <a
      href='/wordpress-malware-removal/'
      data-umami-event='content-next-step-opened'
      data-umami-event-choice='service'
      data-umami-event-context={context}
      data-umami-event-placement={placement}
      class='mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#ed7655] px-4 py-3 text-sm font-extrabold text-[#17352c] transition hover:bg-[#ff8a68]'
    >
      Get malware removal help <ArrowRight class='h-4 w-4' />
    </a>
  </div>

  <div class:list={['grid gap-px bg-[#d7ddd7]', placement === 'inline' && 'sm:grid-cols-2']}>
    <a
      href='/free-wordpress-scan/'
      data-umami-event='content-next-step-opened'
      data-umami-event-choice='scan'
      data-umami-event-context={context}
      data-umami-event-placement={placement}
      class='group flex gap-3 bg-[#eef6f1] p-4 transition hover:bg-[#e3f0e9]'
    >
      <ScanLine class='mt-0.5 h-4 w-4 shrink-0 text-[#1f6b55]' />
      <span>
        <strong class='block text-base text-[#17352c]'>Start with a free scan</strong>
        <span class='mt-1 block text-sm leading-6 text-[#465e55]'>Get a human-reviewed check of public warning signs.</span>
      </span>
    </a>
    <a
      href='/books/wordpress-malware-removal/'
      data-umami-event='content-next-step-opened'
      data-umami-event-choice='book'
      data-umami-event-context={context}
      data-umami-event-placement={placement}
      class='group flex gap-3 bg-[#fffdf8] p-4 transition hover:bg-[#fff7f1]'
    >
      <BookOpen class='mt-0.5 h-4 w-4 shrink-0 text-[#b74e32]' />
      <span>
        <strong class='block text-base text-[#17352c]'>Learn with the book</strong>
        <span class='mt-1 block text-sm leading-6 text-[#465e55]'>Follow practical malware-removal cases and methods.</span>
      </span>
    </a>
  </div>
</section>
