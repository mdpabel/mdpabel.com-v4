---
import { ArrowRight, CheckCircle2, Search, ShieldCheck } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { title:string; description:string; path:string; eyebrow:string; intro:string; formId:string; checks:string[]; faqs:{q:string;a:string}[]; }
const {title,description,path,eyebrow,intro,formId,checks,faqs}=Astro.props;
const url=`https://www.mdpabel.com${path}`;
const schema=[{'@type':'WebPage',name:title,description,url},{'@type':'Service',name:title,description,url,provider:{'@type':'Person',name:'MD Pabel',url:'https://www.mdpabel.com/about/'},offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}},{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}];
---
<NewLayout title={title} description={description} path={path} schema={schema}>
<section class='py-14 md:py-20'><div class='new-shell'><Breadcrumbs items={[{label:eyebrow}]} /><div class='mt-9 grid gap-10 lg:grid-cols-[1fr_.82fr] lg:items-center'><div><p class='mb-4 text-xs font-extrabold uppercase tracking-[.16em] text-[#1f6b55]'>{eyebrow} · Human reviewed</p><h1 class='editorial-heading max-w-3xl font-semibold'>{title.replace(' | MD Pabel','')}</h1><p class='mt-6 max-w-2xl text-lg leading-8 text-[#52665f]'>{intro}</p><ul class='mt-7 grid gap-3 sm:grid-cols-2'>{['No credit card','Public checks first','Clear written findings','No obligation to hire'].map(i=><li class='flex items-center gap-2 text-sm font-semibold'><CheckCircle2 class='h-5 w-5 text-[#1f6b55]'/>{i}</li>)}</ul></div><div class='rounded-3xl border border-[#d7ddd7] bg-[#fffdf8] p-6 shadow-xl shadow-[#17352c]/8 md:p-8'><div class='mb-6 flex items-center gap-3'><span class='grid h-11 w-11 place-items-center rounded-full bg-[#dcece5]'><ShieldCheck class='h-5 w-5 text-[#1f6b55]'/></span><div><h2 class='editorial-heading text-2xl font-semibold'>Request your free check</h2><p class='text-xs text-[#52665f]'>Reviewed personally by MD Pabel</p></div></div><form id='scan-form' class='space-y-4'><label class='block text-sm font-bold'>Website URL<input type='url' name='site-url' placeholder='https://example.com' required class='mt-2 w-full rounded-xl border border-[#c8d1cb] bg-white px-4 py-3 font-normal outline-none focus:ring-2 focus:ring-[#1f6b55]'/></label><label class='block text-sm font-bold'>Email for the report<input type='email' name='your-email' placeholder='you@example.com' required class='mt-2 w-full rounded-xl border border-[#c8d1cb] bg-white px-4 py-3 font-normal outline-none focus:ring-2 focus:ring-[#1f6b55]'/></label><div id='form-feedback' class='hidden rounded-xl p-3 text-sm'></div><button id='scan-submit-btn' class='inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#17352c] px-5 py-3 font-bold text-white transition hover:bg-[#1f6b55]'>Request review <ArrowRight class='h-4 w-4'/></button><p class='text-center text-xs text-[#788780]'>Do not send passwords or private access details here.</p></form></div></div></div></section>
<section class='border-y border-[#d7ddd7] bg-[#dcece5]/35 py-16'><div class='new-shell'><h2 class='editorial-heading text-4xl font-semibold'>What I check</h2><div class='mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3'>{checks.map(c=><div class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-6'><Search class='h-5 w-5 text-[#b74e32]'/><p class='mt-4 text-sm leading-7'>{c}</p></div>)}</div></div></section>
<section class='py-16'><div class='new-shell max-w-4xl'><h2 class='editorial-heading text-4xl font-semibold'>Questions before you submit</h2><div class='mt-8 space-y-3'>{faqs.map(f=><details class='rounded-xl border border-[#d7ddd7] bg-[#fffdf8] p-5'><summary class='cursor-pointer font-bold'>{f.q}</summary><p class='mt-3 text-sm leading-7 text-[#52665f]'>{f.a}</p></details>)}</div></div></section>
</NewLayout>
<script define:vars={{formId}}>
const form=document.getElementById('scan-form');const button=document.getElementById('scan-submit-btn');const feedback=document.getElementById('form-feedback');
form?.addEventListener('submit',async(e)=>{e.preventDefault();if(!(form instanceof HTMLFormElement)||!(button instanceof HTMLButtonElement)||!feedback)return;button.disabled=true;button.textContent='Sending request…';const data=new FormData(form);data.append('from-url',location.pathname);data.append('_wpcf7',formId);data.append('_wpcf7_version','6.1.5');data.append('_wpcf7_locale','en_US');data.append('_wpcf7_unit_tag',`wpcf7-f${formId}-p0-o1`);try{const r=await fetch(`https://cms.mdpabel.com/wp-json/contact-form-7/v1/contact-forms/${formId}/feedback`,{method:'POST',body:data});const result=await r.json();if(result.status!=='mail_sent')throw new Error();feedback.className='block rounded-xl bg-[#dcece5] p-3 text-sm text-[#17352c]';feedback.textContent='Request received. I will review it and reply by email.';form.reset();button.textContent='Request sent ✓';}catch{feedback.className='block rounded-xl bg-[#fee5dc] p-3 text-sm text-[#8a3826]';feedback.textContent='The request could not be sent. Please try again or use the contact page.';button.disabled=false;button.textContent='Request review';}});
</script>
