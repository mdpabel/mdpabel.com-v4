---
import { ArrowRight, CheckCircle2, Search, ShieldCheck } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import {
  CONTACT_FORM_7_VERSION,
  WP_ARMOUR_FIELD_NAME,
  WP_ARMOUR_FIELD_VALUE,
} from '../../lib/contactForms';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow: string;
  intro: string;
  formId: string;
  marketingOptIn?: string;
  checks: string[];
  faqs: { q: string; a: string }[];
}

const {
  title,
  description,
  path,
  eyebrow,
  intro,
  formId,
  marketingOptIn,
  checks,
  faqs,
} = Astro.props;
const contactFormVersion = CONTACT_FORM_7_VERSION;
const linkedinUrl = 'https://www.linkedin.com/in/mdpabe1/';
const tawkUrl =
  'https://tawk.to/chat/68b076a8beccc01925d92112/1j3okv147';
const url = `https://www.mdpabel.com${path}`;
const schema = [
  { '@type': 'WebPage', name: title, description, url },
  {
    '@type': 'Service',
    name: title,
    description,
    url,
    provider: {
      '@type': 'Person',
      name: 'MD Pabel',
      url: 'https://www.mdpabel.com/about/',
    },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<NewLayout title={title} description={description} path={path} schema={schema}>
  <section class='py-14 md:py-20'>
    <div class='new-shell'>
      <Breadcrumbs items={[{ label: eyebrow }]} />
      <div class='mt-9 grid gap-10 lg:grid-cols-[1fr_.82fr] lg:items-center'>
        <div>
          <p
            class='mb-4 text-xs font-extrabold uppercase tracking-[.16em] text-[#1f6b55]'>
            {eyebrow} · Human reviewed
          </p>
          <h1 class='editorial-heading max-w-3xl font-semibold'>
            {title.replace(' | MD Pabel', '')}
          </h1>
          <p class='mt-6 max-w-2xl text-lg leading-8 text-[#52665f]'>
            {intro}
          </p>
          <ul class='mt-7 grid gap-3 sm:grid-cols-2'>
            {
              [
                'No credit card',
                'Public checks first',
                'Clear written findings',
                'No obligation to hire',
              ].map((item) => (
                <li class='flex items-center gap-2 text-sm font-semibold'>
                  <CheckCircle2 class='h-5 w-5 text-[#1f6b55]' />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div
          class='rounded-3xl border border-[#d7ddd7] bg-[#fffdf8] p-6 shadow-xl shadow-[#17352c]/8 md:p-8'>
          <div class='mb-6 flex items-center gap-3'>
            <span class='grid h-11 w-11 place-items-center rounded-full bg-[#dcece5]'>
              <ShieldCheck class='h-5 w-5 text-[#1f6b55]' />
            </span>
            <div>
              <h2 class='editorial-heading text-2xl font-semibold'>
                Request your free check
              </h2>
              <p class='text-xs text-[#52665f]'>Reviewed personally by MD Pabel</p>
            </div>
          </div>
          <form id='scan-form' class='space-y-4'>
            <label class='block text-sm font-bold'
              >Website URL<input
                type='url'
                name='site-url'
                placeholder='https://example.com'
                required
                class='mt-2 w-full rounded-xl border border-[#c8d1cb] bg-white px-4 py-3 font-normal outline-none focus:ring-2 focus:ring-[#1f6b55]'
              /></label
            >
            <label class='block text-sm font-bold'
              >Email for the report<input
                type='email'
                name='your-email'
                placeholder='you@example.com'
                autocomplete='email'
                required
                class='mt-2 w-full rounded-xl border border-[#c8d1cb] bg-white px-4 py-3 font-normal outline-none focus:ring-2 focus:ring-[#1f6b55]'
              /></label
            >
            <label class='block text-sm font-bold'
              >What makes you think your WordPress site is hacked or infected?
              <textarea
                name='symptoms'
                maxlength='2000'
                rows='4'
                placeholder='For example: visitors are redirected, Google shows a warning, or you found an unfamiliar admin.'
                aria-describedby='symptoms-help'
                class='mt-2 w-full resize-y rounded-xl border border-[#c8d1cb] bg-white px-4 py-3 font-normal outline-none focus:ring-2 focus:ring-[#1f6b55]'></textarea>
              <span id='symptoms-help' class='mt-1 block text-xs font-normal text-[#788780]'>Optional, but helpful for focusing the first review.</span>
            </label>
            <div class='hidden' aria-hidden='true'>
              <label
                >Leave this field blank<input
                  name='alt_s'
                  tabindex='-1'
                  autocomplete='off'
                /></label
              >
            </div>
            <input
              type='hidden'
              name={WP_ARMOUR_FIELD_NAME}
              value={WP_ARMOUR_FIELD_VALUE}
            />
            <div
              id='form-feedback'
              role='status'
              aria-live='polite'
              class='hidden rounded-xl p-3 text-sm'>
            </div>
            <p
              id='form-alternatives'
              class='hidden text-center text-xs leading-5 text-[#52665f]'>
              Prefer another way? <a
                href={tawkUrl}
                target='_blank'
                rel='noopener noreferrer'
                data-open-tawk
                class='font-bold text-[#1f6b55] underline'>Open live chat</a
              >, <a
                href={linkedinUrl}
                target='_blank'
                rel='noopener noreferrer me'
                class='font-bold text-[#1f6b55] underline'>message on LinkedIn</a
              >, or <a
                href='mailto:support@mdpabel.com'
                class='font-bold text-[#1f6b55] underline'>send an email</a
              >.
            </p>
            <button
              id='scan-submit-btn'
              type='submit'
              class='inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[#17352c] px-5 py-3 font-bold text-white transition hover:bg-[#1f6b55]'
              >Request review <ArrowRight class='h-4 w-4' /></button
            >
            {
              marketingOptIn && (
                <label class='flex items-start gap-3 text-xs leading-5 text-[#52665f]'>
                  <input
                    name='marketing-consent'
                    type='checkbox'
                    value={marketingOptIn}
                    class='mt-0.5 h-4 w-4 shrink-0 accent-[#1f6b55]'
                  />
                  <span>{marketingOptIn}</span>
                </label>
              )
            }
            <p class='text-center text-xs text-[#788780]'>
              Do not send passwords or private access details here.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class='border-y border-[#d7ddd7] bg-[#dcece5]/35 py-16'>
    <div class='new-shell'>
      <h2 class='editorial-heading text-4xl font-semibold'>What I check</h2>
      <div class='mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3'>
        {
          checks.map((check) => (
            <div class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-6'>
              <Search class='h-5 w-5 text-[#b74e32]' />
              <p class='mt-4 text-sm leading-7'>{check}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class='py-16'>
    <div class='new-shell max-w-4xl'>
      <h2 class='editorial-heading text-4xl font-semibold'>
        Questions before you submit
      </h2>
      <div class='mt-8 space-y-3'>
        {
          faqs.map((faq) => (
            <details class='rounded-xl border border-[#d7ddd7] bg-[#fffdf8] p-5'>
              <summary class='cursor-pointer font-bold'>{faq.q}</summary>
              <p class='mt-3 text-sm leading-7 text-[#52665f]'>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</NewLayout>

<script define:vars={{ formId, contactFormVersion }}>
  const form = document.getElementById('scan-form');
  const button = document.getElementById('scan-submit-btn');
  const feedback = document.getElementById('form-feedback');
  const alternatives = document.getElementById('form-alternatives');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (
      !(form instanceof HTMLFormElement) ||
      !(button instanceof HTMLButtonElement) ||
      !feedback
    )
      return;

    button.disabled = true;
    button.textContent = 'Sending request…';
    alternatives?.classList.add('hidden');
    const data = new FormData(form);
    data.append('from-url', location.pathname);
    data.append('_wpcf7', formId);
    data.append('_wpcf7_version', contactFormVersion);
    data.append('_wpcf7_locale', 'en_US');
    data.append('_wpcf7_unit_tag', `wpcf7-f${formId}-p0-o1`);

    try {
      const response = await fetch(
        `https://cms.mdpabel.com/wp-json/contact-form-7/v1/contact-forms/${formId}/feedback`,
        { method: 'POST', body: data },
      );
      if (!response.ok) throw new Error('The request service is unavailable.');
      const result = await response.json();
      if (result.status !== 'mail_sent')
        throw new Error(result.message || 'The request could not be sent.');

      feedback.className =
        'block rounded-xl bg-[#dcece5] p-3 text-sm text-[#17352c]';
      feedback.textContent =
        'Request received. I will review it and reply by email.';
      alternatives?.classList.add('hidden');
      form.reset();
      button.textContent = 'Request sent ✓';
    } catch (error) {
      feedback.className =
        'block rounded-xl bg-[#fee5dc] p-3 text-sm text-[#8a3826]';
      const message =
        error instanceof Error
          ? error.message
          : 'The request could not be sent.';
      feedback.textContent = message;
      alternatives?.classList.remove('hidden');
      button.disabled = false;
      button.textContent = 'Request review';
    }
  });
</script>
