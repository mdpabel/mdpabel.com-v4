---
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Braces,
  BriefcaseBusiness,
  ChevronDown,
  Compass,
  FileTerminal,
  HeartPulse,
  Library,
  Menu,
  Microscope,
  ScanLine,
  ShieldAlert,
  ShieldCheck,
  Wrench,
  X,
} from '@lucide/astro';

const pathname = Astro.url.pathname;

const services = [
  {
    label: 'Malware removal',
    description: 'Manual cleanup, investigation, and hardening',
    href: '/wordpress-malware-removal/',
    icon: ShieldAlert,
  },
  {
    label: 'WordPress maintenance',
    description: 'Updates, backups, security, and ongoing care',
    href: '/wordpress-maintenance/',
    icon: HeartPulse,
  },
  {
    label: 'Error fixing',
    description: 'Critical errors, failed updates, and broken sites',
    href: '/wordpress-error-fixing/',
    icon: Wrench,
  },
  {
    label: 'Website development',
    description: 'WordPress, Astro, Next.js, and AI-assisted builds',
    href: '/website-development/',
    icon: Braces,
  },
  {
    label: 'Blacklist removal',
    description: 'Browser and antivirus reputation recovery',
    href: '/blacklist-removal/',
    icon: ShieldCheck,
  },
];

const resources = [
  {
    label: 'Malware research',
    description: 'Evidence-led artifact and code analysis',
    href: '/malware-research/',
    icon: Microscope,
  },
  {
    label: 'Case studies',
    description: 'Real cleanup work, evidence, and outcomes',
    href: '/case-studies/',
    icon: BriefcaseBusiness,
  },
  {
    label: 'Blog',
    description: 'WordPress security notes and useful answers',
    href: '/blog/',
    icon: BookOpen,
  },
  {
    label: 'Guides',
    description: 'Practical, step-by-step security guidance',
    href: '/guides/',
    icon: Compass,
  },
  {
    label: 'Malware logs',
    description: 'First-hand malware and forensic observations',
    href: '/malware-log/',
    icon: FileTerminal,
  },
];

const isCurrent = (href: string) =>
  href === '/' ? pathname === href : pathname.startsWith(href);
---

<header
  class='top-0 z-50 sticky bg-[#f7f4ed]/95 backdrop-blur-xl border-[#d7ddd7] border-b'>
  <a
    rel='me'
    href='https://mastodon.social/@mdpabel'
    class='sr-only'>Mastodon</a
  >
  <div class='flex justify-between items-center gap-6 min-h-[78px] new-shell'>
    <div class='flex items-center gap-8 xl:gap-12 min-w-0'>
      <a
        href='/'
        class='inline-flex items-center gap-3 shrink-0'
        aria-label='MD Pabel homepage'>
        <span
          class='place-items-center grid bg-[#17352c] rounded-[50%_50%_50%_14%] w-11 h-11 font-extrabold text-white text-xs tracking-wider'
          >MP</span
        >
        <span class='flex flex-col leading-none'>
          <strong class='text-lg editorial-heading'>MD Pabel</strong>
          <small
            class='mt-1 font-bold text-[#52665f] text-[10px] uppercase tracking-[0.14em]'
            >WordPress security</small
          >
        </span>
      </a>

      <nav
        class='hidden lg:flex items-center gap-1'
        aria-label='Primary navigation'>
        <a
          href='/about/'
          class='nav-link'
          aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a
        >

        <div class='group relative'>
          <a
            href='/services/'
            class='flex items-center gap-1.5 nav-link'
            aria-current={isCurrent('/services/') ? 'page' : undefined}>
            Services <ChevronDown
              class='w-4 h-4 group-focus-within:rotate-180 group-hover:rotate-180 transition-transform duration-200'
            />
          </a>
          <div
            class='invisible group-focus-within:visible group-hover:visible top-full left-0 absolute opacity-0 group-focus-within:opacity-100 group-hover:opacity-100 pt-2 w-[470px] transition-all translate-y-2 group-focus-within:translate-y-0 group-hover:translate-y-0 duration-200 mega-wrap'>
            <div
              class='bg-[#fffdf8] shadow-[#17352c]/12 shadow-xl p-2 border border-[#d7ddd7] rounded-2xl'>
              <div class='gap-1 grid grid-cols-2'>
                {
                  services.map((item) => (
                    <a
                      href={item.href}
                      class='group/item flex items-center gap-2.5 hover:bg-[#dcece5] focus:bg-[#dcece5] p-2.5 rounded-xl focus:outline-none font-extrabold text-[#17352c] text-[13px] transition-colors'>
                      <span class='place-items-center grid bg-[#eef4ef] rounded-lg w-8 h-8 text-[#1f6b55] shrink-0'>
                        <item.icon class='w-4 h-4' />
                      </span>
                      {item.label}
                    </a>
                  ))
                }
                <a
                  href='/services/'
                  class='flex justify-between items-center col-span-2 px-3 pt-2.5 pb-1 border-[#d7ddd7] border-t font-extrabold text-[#52665f] hover:text-[#1f6b55] text-xs'
                  >View all services <ArrowRight class='w-4 h-4' /></a
                >
              </div>
            </div>
          </div>
        </div>

        <a
          href='/books/'
          class='nav-link'
          aria-current={isCurrent('/books/') ? 'page' : undefined}>Books</a
        >

        <div class='group relative'>
          <a
            href='/blog/'
            class='flex items-center gap-1.5 nav-link'
            aria-current={resources.some((item) => isCurrent(item.href))
              ? 'page'
              : undefined}>
            Resources <ChevronDown
              class='w-4 h-4 group-focus-within:rotate-180 group-hover:rotate-180 transition-transform duration-200'
            />
          </a>
          <div
            class='invisible group-focus-within:visible group-hover:visible top-full left-0 absolute opacity-0 group-focus-within:opacity-100 group-hover:opacity-100 pt-2 w-[430px] transition-all translate-y-2 group-focus-within:translate-y-0 group-hover:translate-y-0 duration-200 mega-wrap'>
            <div
              class='bg-[#fffdf8] shadow-[#17352c]/12 shadow-xl p-2 border border-[#d7ddd7] rounded-2xl'>
              <div class='gap-1 grid grid-cols-2'>
                {
                  resources.map((item) => (
                    <a
                      href={item.href}
                      class='group/item flex items-center gap-2.5 hover:bg-[#dcece5] focus:bg-[#dcece5] p-2.5 rounded-xl focus:outline-none font-extrabold text-[#17352c] text-[13px] transition-colors'>
                      <span class='place-items-center grid bg-[#eef4ef] rounded-lg w-8 h-8 text-[#1f6b55] shrink-0'>
                        <item.icon class='w-4 h-4' />
                      </span>
                      {item.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </nav>
    </div>

    <div class='hidden lg:flex items-center gap-4'>
      <a
        href='/books/library/'
        class='inline-flex items-center gap-2 font-bold text-[#52665f] text-sm transition-colors hover:text-[#1f6b55]'>
        <Library class='w-4 h-4' /> My Library
      </a>
      <a
        href='/free-wordpress-scan/'
        class='inline-flex items-center gap-2 font-bold text-[#52665f] text-sm transition-colors free-scan-link'>
        <ScanLine class='w-4 h-4' /> Free scan
      </a>
      <a
        href='/hire-me/'
        class='inline-flex items-center gap-2 px-5 py-2.5 border border-[#17352c] rounded-full font-extrabold text-sm transition-all hover:-translate-y-0.5 header-cta'
        >Hire me <ArrowUpRight class='w-4 h-4' /></a
      >
    </div>

    <details class='group lg:hidden relative mobile-menu'>
      <summary
        class='place-items-center grid border border-[#d7ddd7] rounded-full w-11 h-11 cursor-pointer list-none'
        aria-label='Toggle navigation'>
        <Menu class='w-5 h-5 menu-open' /><X class='w-5 h-5 menu-close' />
      </summary>
      <nav
        class='top-[calc(100%+12px)] right-0 absolute bg-[#fffdf8] shadow-[#17352c]/15 shadow-2xl p-2 border border-[#d7ddd7] rounded-2xl w-[min(360px,calc(100vw-28px))] max-h-[calc(100vh-100px)] overflow-y-auto'
        aria-label='Mobile navigation'>
        <a href='/about/' class='mobile-top-link'>About</a>
        <a href='/books/' class='mobile-top-link'>Books</a>
        <a href='/books/library/' class='mobile-top-link'>My Library</a>
        <details class='mobile-group'>
          <summary>Services <ChevronDown class='w-4 h-4' /></summary><div>
            {services.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </details>
        <details class='mobile-group'>
          <summary>Resources <ChevronDown class='w-4 h-4' /></summary><div>
            {resources.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
        </details>
        <a
          href='/free-wordpress-scan/'
          class='flex justify-between items-center mt-2 px-4 py-3 border border-[#d7ddd7] rounded-xl font-extrabold text-[#17352c] text-sm'
          >Free WordPress scan <ScanLine class='w-4 h-4' /></a
        >
        <a
          href='/hire-me/'
          class='flex justify-between items-center bg-[#1f6b55] mt-2 px-4 py-3 rounded-xl font-extrabold text-white text-sm'
          >Hire me <ArrowUpRight class='w-4 h-4' /></a
        >
      </nav>
    </details>
  </div>
</header>

<style>
  :global(.new-shell) {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }
  .editorial-heading {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    letter-spacing: -0.04em;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 1.85rem 0.85rem;
    color: #3c554c;
    font-size: 0.92rem;
    font-weight: 750;
    letter-spacing: -0.01em;
  }
  .nav-link::after {
    position: absolute;
    right: 0.85rem;
    bottom: 1.25rem;
    left: 0.85rem;
    height: 2px;
    transform: scaleX(0);
    transform-origin: right;
    background: #ed7655;
    content: '';
    transition: transform 180ms ease;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: #17352c;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .free-scan-link:hover,
  .free-scan-link:focus-visible {
    color: #1f6b55;
  }
  .header-cta:hover,
  .header-cta:focus-visible {
    background: #17352c;
    color: #fff;
  }
  .mobile-menu summary::-webkit-details-marker,
  .mobile-group summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu .menu-close {
    display: none;
  }
  .mobile-menu[open] > summary .menu-open {
    display: none;
  }
  .mobile-menu[open] > summary .menu-close {
    display: block;
  }
  .mobile-top-link,
  .mobile-group > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.75rem;
    padding: 0.8rem 0.9rem;
    color: #17352c;
    font-size: 0.95rem;
    font-weight: 800;
  }
  .mobile-top-link:hover,
  .mobile-group > summary:hover {
    background: #eef4ef;
  }
  .mobile-group[open] > summary svg {
    transform: rotate(180deg);
  }
  .mobile-group > div {
    display: grid;
    margin: 0 0.5rem 0.4rem;
    border-left: 1px solid #d7ddd7;
    padding-left: 0.75rem;
  }
  .mobile-group > div a {
    border-radius: 0.65rem;
    padding: 0.62rem 0.75rem;
    color: #52665f;
    font-size: 0.82rem;
    font-weight: 650;
  }
  .mobile-group > div a:hover {
    background: #dcece5;
    color: #17352c;
  }
  @media (max-width: 1180px) {
    .mega-wrap {
      left: -120px;
    }
  }
  @media (max-width: 640px) {
    :global(.new-shell) {
      width: min(100% - 28px, 1180px);
    }
  }
</style>
