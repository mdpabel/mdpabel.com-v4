<!-- Site-wide Tawk.to chat widget. Links marked data-open-tawk open it in place. -->
<script is:inline>
  var Tawk_API = Tawk_API || {};
  var Tawk_LoadStart = new Date();

  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!(target instanceof Element)) return;
    var trigger = target.closest('[data-open-tawk]');
    if (!trigger || typeof Tawk_API.maximize !== 'function') return;

    event.preventDefault();
    Tawk_API.maximize();
  });

  (function () {
    var script = document.createElement('script');
    var firstScript = document.getElementsByTagName('script')[0];
    script.async = true;
    script.src =
      'https://embed.tawk.to/68b076a8beccc01925d92112/1j3okv147';
    script.charset = 'UTF-8';
    script.setAttribute('crossorigin', '*');
    firstScript.parentNode.insertBefore(script, firstScript);
  })();
</script>
