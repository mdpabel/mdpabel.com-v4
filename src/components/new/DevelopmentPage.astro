---
import { ArrowRight, ArrowUpRight, Check, Code2 } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { DevelopmentServiceData } from '../../data/developmentServices';

interface Props { service: DevelopmentServiceData }
const { service } = Astro.props;
const url = `https://www.mdpabel.com${service.slug}`;
const schema = [
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: service.seoTitle, description: service.description, about: { '@id': `${url}#service` } },
  { '@type': 'Service', '@id': `${url}#service`, name: service.name, serviceType: service.name, provider: { '@id': 'https://www.mdpabel.com/about/#person' }, areaServed: 'Worldwide' },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.mdpabel.com/' }, { '@type': 'ListItem', position: 2, name: 'Website Development', item: 'https://www.mdpabel.com/website-development/' }, { '@type': 'ListItem', position: 3, name: service.name, item: url }] },
  { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: service.faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
];
---

<NewLayout title={service.seoTitle} description={service.description} path={service.slug} schema={schema}>
  <section class='relative overflow-hidden border-b border-[#d7ddd7] py-16 md:py-24'><div class='pointer-events-none absolute right-0 top-0 h-full w-1/2 opacity-40 [background-image:linear-gradient(#1f6b5517_1px,transparent_1px),linear-gradient(90deg,#1f6b5517_1px,transparent_1px)] [background-size:32px_32px] [mask-image:linear-gradient(to_left,black,transparent)]'></div><div class='new-shell relative'><Breadcrumbs items={[{ label: 'Website Development', href: '/website-development/' }, { label: service.name }]} /><div class='mt-10 grid items-center gap-12 lg:grid-cols-[1.15fr_0.65fr]'><div><p class='mb-4 text-xs font-extrabold uppercase tracking-[0.16em] text-[#1f6b55]'>{service.eyebrow}</p><h1 class='editorial-heading text-5xl font-semibold leading-[0.96] md:text-7xl'>{service.headline}</h1><p class='mt-7 max-w-3xl text-lg leading-8 text-[#52665f]'>{service.intro}</p><a href='/hire-me/' class='mt-8 inline-flex items-center gap-2 rounded-full bg-[#1f6b55] px-6 py-3.5 text-sm font-bold text-white'>Discuss your project <ArrowRight class='h-4 w-4' /></a></div><aside class='rounded-[2rem_0.75rem_2rem_0.75rem] bg-[#17352c] p-7 text-white'><Code2 class='h-7 w-7 text-[#ed7655]' /><h2 class='editorial-heading mt-6 text-3xl font-semibold'>Technology with a reason.</h2><p class='mt-4 text-sm leading-7 text-[#c9d9d2]'>The build is planned around content, users, integrations, ownership, and future change—not around forcing every project into one preferred stack.</p><div class='mt-6 flex flex-wrap gap-2'>{service.technology.map((item) => <span class='rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-[10px] font-bold'>{item}</span>)}</div></aside></div></div></section>
  <section class='py-20 md:py-28'><div class='new-shell grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24'><div><p class='mb-3 text-xs font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>A strong fit for</p><h2 class='editorial-heading text-4xl font-semibold md:text-5xl'>Projects with these needs.</h2></div><div class='grid gap-px overflow-hidden rounded-2xl border border-[#d7ddd7] bg-[#d7ddd7] sm:grid-cols-2'>{service.bestFor.map((item) => <div class='flex gap-3 bg-[#fffdf8] p-5 text-sm font-semibold'><Check class='h-4 w-4 shrink-0 text-[#ed7655]' />{item}</div>)}</div></div></section>
  <section class='bg-[#fffdf8] py-20 md:py-28'><div class='new-shell'><div class='max-w-3xl'><p class='mb-3 text-xs font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>Development scope</p><h2 class='editorial-heading text-4xl font-semibold md:text-6xl'>What I can design and deliver.</h2></div><div class='mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3'>{service.deliverables.map((item, index) => <article class='rounded-2xl border border-[#d7ddd7] bg-[#f7f4ed] p-6'><span class='editorial-heading text-sm text-[#ed7655]'>0{index + 1}</span><h3 class='editorial-heading mt-8 text-2xl font-semibold'>{item.title}</h3><p class='mt-3 text-sm leading-7 text-[#52665f]'>{item.description}</p></article>)}</div></div></section>
  <section class='py-20 md:py-28'><div class='new-shell grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24'><div><h2 class='editorial-heading text-4xl font-semibold md:text-5xl'>Questions before choosing the stack.</h2></div><div class='divide-y divide-[#d7ddd7] border-y border-[#d7ddd7]'>{service.faqs.map((faq) => <details class='group py-5'><summary class='flex cursor-pointer list-none justify-between gap-4 font-bold'>{faq.question}<span class='text-[#ed7655] group-open:rotate-45'>+</span></summary><p class='pt-4 text-sm leading-7 text-[#52665f]'>{faq.answer}</p></details>)}</div></div></section>
  <section class='pb-24'><div class='new-shell rounded-3xl bg-[#1f6b55] p-8 text-white md:p-12'><div class='grid items-center gap-8 md:grid-cols-[1fr_auto]'><div><p class='text-xs font-bold uppercase tracking-[0.14em] text-[#b9d8cc]'>Have a project in mind?</p><h2 class='editorial-heading mt-3 text-4xl font-semibold'>Start with the problem, users, and desired outcome.</h2></div><a href='/hire-me/' class='inline-flex w-fit items-center gap-2 rounded-full bg-[#ed7655] px-6 py-3 font-bold'>Discuss the build <ArrowUpRight class='h-4 w-4' /></a></div></div></section>
</NewLayout>
