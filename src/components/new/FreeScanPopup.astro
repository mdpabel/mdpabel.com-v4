---
import { ArrowRight, BookOpen, ScanLine, ShieldCheck, X } from '@lucide/astro';

const bookDiscountCode = 'EXTRA15';
const bookCheckoutUrl = `https://checkout.mdpabel.com/checkout/buy/e5ebff5e-0903-433f-a892-bb6ef0dbdc3d?checkout%5Bdiscount_code%5D=${bookDiscountCode}&utm_source=content-popup&utm_medium=site&utm_campaign=malware-research-book-discount`;
---

<aside
  id='free-scan-popup'
  class='scan-popup fixed bottom-4 right-4 z-[70] w-[min(390px,calc(100vw-28px))] overflow-hidden rounded-2xl border border-[#cad5cf] bg-[#fffdf8] shadow-2xl shadow-[#17352c]/20'
  role='dialog'
  aria-modal='false'
  aria-labelledby='content-help-popup-title'>
  <div class='h-1 bg-[#ed7655]'></div>
  <button id='free-scan-popup-close' type='button' class='absolute right-3 top-4 grid h-8 w-8 place-items-center rounded-full text-[#65766f] transition hover:bg-[#eef4ef] hover:text-[#17352c]' aria-label='Dismiss content help options'>
    <X class='h-4 w-4' />
  </button>
  <div class='p-5 pr-12'>
    <span class='grid h-10 w-10 place-items-center rounded-xl bg-[#dcece5] text-[#1f6b55]'><ShieldCheck class='h-5 w-5' /></span>
    <p class='mt-4 text-[10px] font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>A useful next step</p>
    <h2 id='content-help-popup-title' class='editorial-heading mt-2 text-2xl font-semibold leading-tight'>What would help you most?</h2>
    <p class='mt-3 text-sm leading-6 text-[#52665f]'>Choose a practical next step for your site, your skills, or your security questions.</p>
    <div class='mt-5 grid gap-3'>
      <a href='/wordpress-malware-removal/' data-content-popup-choice='service' class='group rounded-xl border border-[#d7ddd7] bg-[#eef6f1] p-4 transition hover:-translate-y-0.5 hover:border-[#1f6b55]'>
        <span class='flex items-center justify-between gap-3 font-extrabold text-[#17352c]'>Need malware cleaned? <ShieldCheck class='h-4 w-4 text-[#1f6b55]' /></span>
        <span class='mt-1 block text-xs leading-5 text-[#52665f]'>Get hands-on WordPress malware removal and recovery help.</span>
      </a>
      <a href={bookCheckoutUrl} data-content-popup-choice='book' data-book-discount-code={bookDiscountCode} class='group rounded-xl border border-[#f2c7b9] bg-[#fff3ed] p-4 transition hover:-translate-y-0.5 hover:border-[#ed7655]'>
        <span class='flex items-center justify-between gap-3 font-extrabold text-[#17352c]'><span class='flex items-center gap-2'><BookOpen class='h-4 w-4 text-[#b84e31]' />Learn malware removal</span><ArrowRight class='h-4 w-4 transition group-hover:translate-x-1' /></span>
        <span class='mt-1 block text-xs leading-5 text-[#52665f]'>Get the book with code <strong class='text-[#9f432c]'>{bookDiscountCode}</strong>.</span>
      </a>
      <a href='/free-wordpress-scan/' data-content-popup-choice='scan' class='group rounded-xl border border-[#d7ddd7] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#1f6b55]'>
        <span class='flex items-center justify-between gap-3 font-extrabold text-[#17352c]'>Want a free scan first? <ScanLine class='h-4 w-4 text-[#1f6b55]' /></span>
        <span class='mt-1 block text-xs leading-5 text-[#52665f]'>Request a human-reviewed check of public warning signs.</span>
      </a>
    </div>
  </div>
</aside>

<style>
  .scan-popup {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(14px);
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms ease;
  }

  .scan-popup.is-visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .editorial-heading {
    font-family: "Source Serif 4 Variable", Georgia, serif;
    letter-spacing: -.035em;
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-popup { transition: none; }
  }
</style>

<script>
  const popup = document.getElementById('free-scan-popup');
  const closeButton = document.getElementById('free-scan-popup-close');
  const choiceLinks = popup?.querySelectorAll<HTMLAnchorElement>('[data-content-popup-choice]');
  const dismissKey = 'mdp-content-help-popup-dismissed-until';
  const sessionKey = 'mdp-content-help-popup-shown';
  const sevenDays = 7 * 24 * 60 * 60 * 1000;
  const thirtyDays = 30 * 24 * 60 * 60 * 1000;
  let hasShown = false;
  let fallbackTimer: number | undefined;

  function storageAvailable(storage: Storage, key: string) {
    try { storage.setItem(key, '1'); storage.removeItem(key); return true; } catch { return false; }
  }

  const canUseLocal = storageAvailable(localStorage, 'mdp-storage-test');
  const canUseSession = storageAvailable(sessionStorage, 'mdp-session-test');
  const dismissedUntil = canUseLocal ? Number(localStorage.getItem(dismissKey) || 0) : 0;
  const shownThisSession = canUseSession && sessionStorage.getItem(sessionKey) === '1';

  function showPopup() {
    if (!popup || hasShown || dismissedUntil > Date.now() || shownThisSession) return;
    hasShown = true;
    if (canUseSession) sessionStorage.setItem(sessionKey, '1');
    popup.classList.add('is-visible');
    window.removeEventListener('scroll', checkScroll);
    if (fallbackTimer) window.clearTimeout(fallbackTimer);
  }

  function dismissPopup(duration = sevenDays) {
    popup?.classList.remove('is-visible');
    if (canUseLocal) localStorage.setItem(dismissKey, String(Date.now() + duration));
  }

  function checkScroll() {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    if (scrollable > 0 && window.scrollY / scrollable >= 0.35) showPopup();
  }

  if (popup && dismissedUntil <= Date.now() && !shownThisSession) {
    window.addEventListener('scroll', checkScroll, { passive: true });
    fallbackTimer = window.setTimeout(showPopup, 12000);
    checkScroll();
  }

  closeButton?.addEventListener('click', () => dismissPopup());
  choiceLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      dismissPopup(thirtyDays);
      const choice = link.dataset.contentPopupChoice;
      const umami = (window as Window & { umami?: { track?: (name: string, data?: Record<string, string>) => void } }).umami;
      if (choice) umami?.track?.('content-help-popup-choice', { choice, page: window.location.pathname });
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && popup?.classList.contains('is-visible')) dismissPopup();
  });
</script>
