---
import { ArrowRight, ScanLine, ShieldCheck, X } from '@lucide/astro';
---

<aside
  id='free-scan-popup'
  class='scan-popup fixed bottom-4 right-4 z-[70] w-[min(390px,calc(100vw-28px))] overflow-hidden rounded-2xl border border-[#cad5cf] bg-[#fffdf8] shadow-2xl shadow-[#17352c]/20'
  role='dialog'
  aria-modal='false'
  aria-labelledby='free-scan-popup-title'>
  <div class='h-1 bg-[#ed7655]'></div>
  <button id='free-scan-popup-close' type='button' class='absolute right-3 top-4 grid h-8 w-8 place-items-center rounded-full text-[#65766f] transition hover:bg-[#eef4ef] hover:text-[#17352c]' aria-label='Dismiss free scan suggestion'>
    <X class='h-4 w-4' />
  </button>
  <div class='p-5 pr-12'>
    <span class='grid h-10 w-10 place-items-center rounded-xl bg-[#dcece5] text-[#1f6b55]'><ShieldCheck class='h-5 w-5' /></span>
    <p class='mt-4 text-[10px] font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>Free human-reviewed check</p>
    <h2 id='free-scan-popup-title' class='editorial-heading mt-2 text-2xl font-semibold leading-tight'>Not sure whether your WordPress site is safe?</h2>
    <p class='mt-3 text-sm leading-6 text-[#52665f]'>Share the URL. I’ll review the public warning signs and explain the most useful next step.</p>
    <a id='free-scan-popup-cta' href='/free-wordpress-scan/' class='mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#1f6b55] px-5 py-3 text-sm font-extrabold text-white transition hover:bg-[#164a3c]'>Request a free scan <ScanLine class='h-4 w-4' /><ArrowRight class='h-4 w-4' /></a>
  </div>
</aside>

<style>
  .scan-popup {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(14px);
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms ease;
  }

  .scan-popup.is-visible {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .editorial-heading {
    font-family: "Source Serif 4 Variable", Georgia, serif;
    letter-spacing: -.035em;
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-popup { transition: none; }
  }
</style>

<script>
  const popup = document.getElementById('free-scan-popup');
  const closeButton = document.getElementById('free-scan-popup-close');
  const cta = document.getElementById('free-scan-popup-cta');
  const dismissKey = 'mdp-free-scan-popup-dismissed-until';
  const sessionKey = 'mdp-free-scan-popup-shown';
  const sevenDays = 7 * 24 * 60 * 60 * 1000;
  const thirtyDays = 30 * 24 * 60 * 60 * 1000;
  let hasShown = false;
  let fallbackTimer: number | undefined;

  function storageAvailable(storage: Storage, key: string) {
    try { storage.setItem(key, '1'); storage.removeItem(key); return true; } catch { return false; }
  }

  const canUseLocal = storageAvailable(localStorage, 'mdp-storage-test');
  const canUseSession = storageAvailable(sessionStorage, 'mdp-session-test');
  const dismissedUntil = canUseLocal ? Number(localStorage.getItem(dismissKey) || 0) : 0;
  const shownThisSession = canUseSession && sessionStorage.getItem(sessionKey) === '1';

  function showPopup() {
    if (!popup || hasShown || dismissedUntil > Date.now() || shownThisSession) return;
    hasShown = true;
    if (canUseSession) sessionStorage.setItem(sessionKey, '1');
    popup.classList.add('is-visible');
    window.removeEventListener('scroll', checkScroll);
    if (fallbackTimer) window.clearTimeout(fallbackTimer);
  }

  function dismissPopup(duration = sevenDays) {
    popup?.classList.remove('is-visible');
    if (canUseLocal) localStorage.setItem(dismissKey, String(Date.now() + duration));
  }

  function checkScroll() {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    if (scrollable > 0 && window.scrollY / scrollable >= 0.35) showPopup();
  }

  if (popup && dismissedUntil <= Date.now() && !shownThisSession) {
    window.addEventListener('scroll', checkScroll, { passive: true });
    fallbackTimer = window.setTimeout(showPopup, 22000);
    checkScroll();
  }

  closeButton?.addEventListener('click', () => dismissPopup());
  cta?.addEventListener('click', () => dismissPopup(thirtyDays));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && popup?.classList.contains('is-visible')) dismissPopup();
  });
</script>
