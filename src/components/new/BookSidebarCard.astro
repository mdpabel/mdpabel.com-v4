---
import { ArrowRight, BookOpen } from '@lucide/astro';
---

<section class='overflow-hidden rounded-2xl border border-[#295044] bg-[#17352c] text-white shadow-lg shadow-[#17352c]/10'>
  <div class='relative h-28 overflow-hidden border-b border-white/10'>
    <img
      src='/images/book/wordpress-malware-removal-book-social.png'
      alt='WordPress Malware Recovery book preview'
      width='1734'
      height='907'
      loading='lazy'
      decoding='async'
      class='h-full w-full object-cover object-[72%_48%]'
    />
    <div class='absolute inset-0 bg-gradient-to-r from-[#17352c]/35 to-transparent'></div>
    <span class='absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-[#fffdf8] px-3 py-1.5 text-[9px] font-extrabold uppercase tracking-[0.12em] text-[#1f6b55] shadow-sm'>
      <BookOpen class='h-3 w-3' /> Free Chapter 1
    </span>
  </div>
  <div class='p-5'>
    <p class='text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#8ed0b5]'>Forthcoming book</p>
    <h2 class='editorial-heading mt-2 text-2xl font-semibold leading-7'>WordPress Malware Recovery</h2>
    <p class='mt-3 text-xs leading-6 text-[#c8d8d1]'>Real cases across files, databases, hidden users, redirects, SEO spam, and WooCommerce checkout.</p>
    <a href='/wordpress-malware-removal-book/' class='mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#ed7655] px-4 py-2.5 text-xs font-extrabold text-[#17352c] transition hover:bg-[#ff8a68]'>
      Explore the book <ArrowRight class='h-4 w-4' />
    </a>
  </div>
</section>
