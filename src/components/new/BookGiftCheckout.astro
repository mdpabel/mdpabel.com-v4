---
import {
  ArrowRight,
  Check,
  LockKeyhole,
  Minus,
  Plus,
} from '@lucide/astro';

interface Props {
  productKey: string;
  productTitle: string;
  unitPrice: number;
  launchPrice: number;
  checkoutUrl: string;
}

const { productKey, productTitle, unitPrice, launchPrice, checkoutUrl } = Astro.props;
const inputClass =
  'w-full rounded-xl border border-[#cbd4cf] bg-white px-4 py-3 text-sm text-[#17352c] outline-none transition focus:border-[#1f6b55] focus:ring-4 focus:ring-[#1f6b55]/10';
---

<section id='book-quantity' class='scroll-mt-24 border-b border-[#d7ddd7] bg-[#eef4ef] py-16 md:py-20'>
  <div class='new-shell'>
    <div class='grid items-start gap-9 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14'>
      <div class='lg:sticky lg:top-8'>
        <div class='inline-flex items-center gap-2 rounded-full border border-[#1f6b55]/15 bg-white px-3.5 py-2 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#1f6b55] shadow-sm'>
          Multiple-copy checkout
        </div>
        <h2 class='editorial-heading mt-5 text-4xl font-semibold md:text-5xl'>Buy the number of copies you need.</h2>
        <p class='mt-5 max-w-xl leading-8 text-[#52665f]'>
          Select your total quantity, see the discounted launch total, and complete one secure Lemon Squeezy checkout.
        </p>
        <div class='mt-7 grid gap-3 text-sm'>
          <span class='flex gap-3 rounded-xl border border-[#d7ddd7] bg-white/75 p-4'><Check class='h-5 w-5 shrink-0 text-[#1f6b55]' /><span><strong class='block text-[#17352c]'>Quantity discounts</strong><small class='mt-1 block leading-5 text-[#65766f]'>Buy multiple copies in one order with the launch price.</small></span></span>
          <span class='flex gap-3 rounded-xl border border-[#d7ddd7] bg-white/75 p-4'><LockKeyhole class='h-5 w-5 shrink-0 text-[#1f6b55]' /><span><strong class='block text-[#17352c]'>Payment stays secure</strong><small class='mt-1 block leading-5 text-[#65766f]'>Payment is completed on Lemon Squeezy.</small></span></span>
        </div>
      </div>

      <div class='relative rounded-[2rem] border border-[#d7ddd7] bg-[#fffdf8] p-6 shadow-2xl shadow-[#17352c]/8 md:p-9'>
        <div class='flex flex-wrap items-start justify-between gap-4 border-b border-[#d7ddd7] pb-6'>
          <div>
            <p class='text-[10px] font-extrabold uppercase tracking-[0.15em] text-[#b84e31]'>Mini cart</p>
            <h3 class='editorial-heading mt-2 text-2xl font-semibold'>{productTitle}</h3>
          </div>
          <span class='rounded-full bg-[#dcece5] px-3 py-2 text-xs font-extrabold text-[#1f6b55]'><s class='mr-1 text-[#65766f]'>${unitPrice.toFixed(2)}</s> ${launchPrice.toFixed(2)} launch price</span>
        </div>

        <form
          data-gift-order-form
          class='mt-6 grid gap-6'
          data-product-key={productKey}
          data-product-title={productTitle}
          data-unit-price={unitPrice}
          data-launch-price={launchPrice}
          data-checkout-url={checkoutUrl}>
          <div class='grid gap-5 sm:grid-cols-2'>
            <label class='grid gap-2 text-xs font-bold'>Your name
              <input data-gift-buyer-name name='gift-buyer-name' class={inputClass} autocomplete='name' minlength='2' required />
            </label>
            <label class='grid gap-2 text-xs font-bold'>Your checkout email
              <input data-gift-buyer-email name='gift-buyer-email' type='email' class={inputClass} autocomplete='email' required />
            </label>
          </div>

          <fieldset class='rounded-2xl border border-[#d7ddd7] bg-[#f7f4ed] p-5'>
            <legend class='px-1 text-xs font-bold'>Total copies</legend>
            <div class='flex flex-wrap items-center justify-between gap-5'>
              <div class='inline-flex items-center rounded-full border border-[#cbd4cf] bg-white p-1'>
                <button data-gift-quantity-minus type='button' class='grid h-10 w-10 place-items-center rounded-full text-[#1f6b55] transition hover:bg-[#dcece5]' aria-label='Reduce quantity'><Minus class='h-4 w-4' /></button>
                <output data-gift-quantity-output class='min-w-12 text-center text-lg font-extrabold text-[#17352c]' aria-live='polite'>1</output>
                <input data-gift-quantity name='gift-quantity' type='hidden' value='1' />
                <button data-gift-quantity-plus type='button' class='grid h-10 w-10 place-items-center rounded-full text-[#1f6b55] transition hover:bg-[#dcece5]' aria-label='Increase quantity'><Plus class='h-4 w-4' /></button>
              </div>
              <div class='text-right'>
                <s data-gift-regular-subtotal class='block text-xs text-[#788780]'>${unitPrice.toFixed(2)}</s>
                <strong data-gift-subtotal class='block text-lg text-[#17352c]'>${launchPrice.toFixed(2)}</strong>
                <span class='text-[11px] leading-5 text-[#65766f]'>Estimated launch total before tax<br />LAUNCH70 applied at checkout</span>
              </div>
            </div>
          </fieldset>

          <div data-gift-error role='alert' aria-live='polite' class='hidden rounded-xl bg-[#fee5dc] p-3 text-sm text-[#9f432c]'></div>
          <button data-gift-submit type='submit' class='group inline-flex items-center justify-center gap-2 rounded-full bg-[#1f6b55] px-6 py-3.5 text-sm font-extrabold text-white shadow-lg shadow-[#17352c]/10 transition hover:-translate-y-0.5 hover:bg-[#164a3c] disabled:cursor-wait disabled:opacity-70'>
            Continue to secure checkout <ArrowRight class='h-4 w-4 transition group-hover:translate-x-0.5' />
          </button>
          <p class='text-center text-[11px] leading-5 text-[#788780]'>You’ll complete payment securely on Lemon Squeezy after selecting your quantity.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-gift-order-form]').forEach((form) => {
    if (form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const quantityInput = form.querySelector<HTMLInputElement>('[data-gift-quantity]');
    const quantityOutput = form.querySelector<HTMLOutputElement>('[data-gift-quantity-output]');
    const quantityMinus = form.querySelector<HTMLButtonElement>('[data-gift-quantity-minus]');
    const quantityPlus = form.querySelector<HTMLButtonElement>('[data-gift-quantity-plus]');
    const subtotal = form.querySelector<HTMLElement>('[data-gift-subtotal]');
    const regularSubtotal = form.querySelector<HTMLElement>('[data-gift-regular-subtotal]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-gift-submit]');
    const errorMessage = form.querySelector<HTMLElement>('[data-gift-error]');
    const unitPrice = Number(form.dataset.unitPrice || 0);
    const discountedUnitPrice = Number(form.dataset.launchPrice || 0);

    const getQuantity = () => Number(quantityInput?.value || 1);
    const showError = (message: string) => {
      if (!errorMessage) return;
      errorMessage.textContent = message;
      errorMessage.classList.remove('hidden');
    };

    const updateOrder = (nextQuantity = getQuantity()) => {
      const quantity = Math.min(10, Math.max(1, nextQuantity));
      if (quantityInput) quantityInput.value = String(quantity);
      if (quantityOutput) quantityOutput.textContent = String(quantity);
      if (regularSubtotal) regularSubtotal.textContent = `$${(unitPrice * quantity).toFixed(2)}`;
      if (subtotal) subtotal.textContent = `$${(discountedUnitPrice * quantity).toFixed(2)}`;
      if (quantityMinus) quantityMinus.disabled = quantity <= 1;
      if (quantityPlus) quantityPlus.disabled = quantity >= 10;
    };

    updateOrder(1);
    quantityMinus?.addEventListener('click', () => updateOrder(getQuantity() - 1));
    quantityPlus?.addEventListener('click', () => updateOrder(getQuantity() + 1));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorMessage?.classList.add('hidden');
      if (!form.reportValidity()) return;

      const buyerName = form.querySelector<HTMLInputElement>('[data-gift-buyer-name]')?.value.trim();
      const buyerEmail = form.querySelector<HTMLInputElement>('[data-gift-buyer-email]')?.value.trim().toLowerCase();
      const quantity = getQuantity();

      if (!buyerName || !buyerEmail) {
        showError('Please complete the buyer details correctly.');
        return;
      }
      const finalCheckoutUrl = new URL(form.dataset.checkoutUrl || '');
      finalCheckoutUrl.searchParams.set('quantity', String(quantity));
      finalCheckoutUrl.searchParams.set('checkout[email]', buyerEmail);
      finalCheckoutUrl.searchParams.set('checkout[name]', buyerName);

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Opening secure checkout…';
      }
      window.location.assign(finalCheckoutUrl.toString());
    });
  });
</script>
