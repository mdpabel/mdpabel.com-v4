---
import { ArrowRight, ArrowUpRight, BadgeCheck, CalendarDays, Clock3 } from '@lucide/astro';
import { load } from 'cheerio';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CommentForm from './CommentForm.astro';
import FreeScanPopup from './FreeScanPopup.astro';
import type { WordPressPost } from '../../lib/wordpress';
import { getWordPressMediaUrl, isR2MediaUrl, resolveMediaSrcset, resolveMediaUrl } from '../../lib/media';

interface Props {
  post: WordPressPost;
  relatedPosts?: WordPressPost[];
  rootSlug: string;
  label: string;
  kind?: 'blog' | 'article';
}
const { post, relatedPosts = [], rootSlug, label, kind = 'article' } = Astro.props;

function plainText(value = '') {
  return load(value, null, false).text().replace(/\s+/g, ' ').trim();
}

function extractFaqs(value = '') {
  const $ = load(value, null, false);
  const faqHeading = $('h2').filter((_, element) => /^frequently asked questions$/i.test($(element).text().trim())).first();
  if (!faqHeading.length) return [];

  const faqs: { question: string; answer: string }[] = [];
  let currentQuestion = '';
  let answerParts: string[] = [];

  const saveCurrentFaq = () => {
    const answer = plainText(answerParts.join(' '));
    if (currentQuestion && answer) faqs.push({ question: currentQuestion, answer });
  };

  for (const element of faqHeading.nextAll().toArray()) {
    const tagName = element.tagName?.toLowerCase();
    if (tagName === 'h2') break;
    if (tagName === 'h3') {
      saveCurrentFaq();
      currentQuestion = plainText($(element).html() || $(element).text());
      answerParts = [];
      continue;
    }
    if (currentQuestion) answerParts.push($(element).text());
  }
  saveCurrentFaq();
  return faqs;
}

function processHtml(value = '') {
  const $ = load(value, null, false);
  $('a').each((_, element) => {
    const href = $(element).attr('href');
    if (!href) return;
    const isInternal = href.startsWith('/') || href.startsWith('https://www.mdpabel.com') || href.startsWith('https://mdpabel.com');
    if (!isInternal) { $(element).attr('target', '_blank'); $(element).attr('rel', 'noopener noreferrer'); return; }
    const [withoutHash, hash] = href.split('#');
    const [path, query] = withoutHash.split('?');
    if (path && !path.endsWith('/') && !/\.[a-z0-9]+$/i.test(path)) {
      $(element).attr('href', `${path}/${query ? `?${query}` : ''}${hash ? `#${hash}` : ''}`);
    }
  });
  $('[src], [data-src]').each((_, element) => {
    for (const attribute of ['src', 'data-src']) {
      const source = $(element).attr(attribute);
      if (!source) continue;
      const preferredSource = resolveMediaUrl(source);
      $(element).attr(attribute, preferredSource);
      if (isR2MediaUrl(preferredSource)) {
        $(element).attr('data-fallback-src', preferredSource !== source ? source : getWordPressMediaUrl(preferredSource));
      }
    }
  });
  $('[srcset], [data-srcset]').each((_, element) => {
    for (const attribute of ['srcset', 'data-srcset']) {
      const srcset = $(element).attr(attribute);
      if (srcset) $(element).attr(attribute, resolveMediaSrcset(srcset));
    }
  });
  $('a[href]').each((_, element) => {
    const href = $(element).attr('href');
    if (href) $(element).attr('href', resolveMediaUrl(href));
  });
  $('img').attr('loading', 'lazy').attr('decoding', 'async');
  return $.html();
}

const content = processHtml(post.content);
const seoTitle = post.yoastSEO?.title || `${plainText(post.title)} | MD Pabel`;
const description = post.yoastSEO?.description || plainText(post.excerpt).slice(0, 158) || `Read ${plainText(post.title)} by MD Pabel.`;
const path = `/${rootSlug}/${post.slug}/`;
const url = `https://www.mdpabel.com${path}`;
const featuredImage = post.featuredImage ? resolveMediaUrl(post.featuredImage.url) : undefined;
const image = resolveMediaUrl(featuredImage || post.yoastSEO?.og_image?.[0]?.url || '/images/blog-opengraph-image.png');
const wordCount = plainText(post.content).split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
const articleType = kind === 'blog' ? 'BlogPosting' : 'Article';
const faqs = extractFaqs(post.content);
const schema = [
  { '@type': articleType, '@id': `${url}#article`, headline: plainText(post.title), description, image, datePublished: post.date, dateModified: post.modified || post.date, mainEntityOfPage: { '@id': `${url}#webpage` }, author: { '@id': 'https://www.mdpabel.com/about/#person' }, publisher: { '@id': 'https://www.mdpabel.com/about/#person' }, articleSection: label, wordCount },
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: seoTitle, description, isPartOf: { '@id': 'https://www.mdpabel.com/#website' }, breadcrumb: { '@id': `${url}#breadcrumb` }, primaryImageOfPage: image, datePublished: post.date, dateModified: post.modified || post.date },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.mdpabel.com/' }, { '@type': 'ListItem', position: 2, name: label, item: `https://www.mdpabel.com/${rootSlug}/` }, { '@type': 'ListItem', position: 3, name: plainText(post.title), item: url }] },
  ...(faqs.length > 0 ? [{ '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }] : []),
];

const malwareFields = rootSlug === 'malware-log' && post.acf ? [
  ['Issue reported', post.acf.issue_reported],
  ['Malware analysis', post.acf.malware_type],
  ['Location of infection', post.acf.location_of_infection],
  ['Cleanup steps', post.acf.cleanup_steps],
  ['Final result', post.acf.result],
].filter(([, value]) => plainText(value)) : [];
---

<NewLayout title={seoTitle} description={description} path={path} image={image} type='article' schema={schema}>
  <section class='border-b border-[#d7ddd7] py-12 md:py-16'><div class='new-shell max-w-6xl'><Breadcrumbs items={[{ label, href: `/${rootSlug}/` }, { label: plainText(post.title) }]} /><div class='mt-8 max-w-5xl'><p class='text-xs font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>{label}</p><h1 class='editorial-heading mt-4 text-4xl font-semibold leading-[1.02] md:text-6xl'><span set:html={post.title} /></h1><div class='mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-semibold text-[#65766f]'><a href='/about/' rel='author' class='flex items-center gap-2 text-[#17352c]'><BadgeCheck class='h-4 w-4 text-[#1f6b55]' />MD Pabel</a><time datetime={post.date} class='flex items-center gap-2'><CalendarDays class='h-4 w-4' />{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time><span class='flex items-center gap-2'><Clock3 class='h-4 w-4' />{readingMinutes} min read</span></div></div></div></section>
  {post.featuredImage && featuredImage && <div class='new-shell max-w-6xl pt-8'><img src={featuredImage} alt={post.featuredImage.alt || plainText(post.title)} width={post.featuredImage.width || 1200} height={post.featuredImage.height || 630} class='max-h-[620px] w-full rounded-2xl border border-[#d7ddd7] object-cover' loading='eager' fetchpriority='high' decoding='async' data-fallback-src={isR2MediaUrl(featuredImage) ? getWordPressMediaUrl(featuredImage) : undefined} /></div>}
  <div class='new-shell grid max-w-6xl items-start gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_300px] lg:py-16'>
    <article class='min-w-0'>
      {content && <div class='article-prose' set:html={content} />}
      {malwareFields.length > 0 && <div class='mt-12 space-y-10'>{malwareFields.map(([heading, value]) => <section class='border-t border-[#d7ddd7] pt-8'><h2 class='editorial-heading text-3xl font-semibold'>{heading}</h2><div class='article-prose mt-5' set:html={processHtml(value)} /></section>)}</div>}
      <section class='mt-14 rounded-3xl bg-[#dcece5] p-7'><p class='text-xs font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>About the author</p><h2 class='editorial-heading mt-3 text-3xl font-semibold'>MD Pabel</h2><p class='mt-3 text-sm leading-7 text-[#52665f]'>Independent WordPress security specialist with first-hand experience across more than 4,500 hacked-site cleanups since 2018.</p><a href='/about/' class='mt-5 inline-flex items-center gap-2 text-xs font-bold'>Experience and methodology <ArrowRight class='h-4 w-4' /></a></section>
      <CommentForm postId={post.id} />
    </article>
    <aside class='space-y-5 lg:sticky lg:top-6'>
      <section class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-5'><p class='text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#ed7655]'>Need expert help?</p><h2 class='editorial-heading mt-3 text-2xl font-semibold'>A website problem is easier with a clear next step.</h2><p class='mt-3 text-xs leading-6 text-[#52665f]'>Share the URL and what you are seeing. I’ll help identify the relevant service.</p><a href='/hire-me/' class='mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#1f6b55] px-4 py-2.5 text-xs font-bold text-white'>Discuss your website <ArrowUpRight class='h-4 w-4' /></a></section>
      <section class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-5'><h2 class='editorial-heading text-xl font-semibold'>Relevant services</h2><div class='mt-3 divide-y divide-[#d7ddd7]'><a href='/wordpress-malware-removal/' class='block py-3 text-sm font-bold'>WordPress malware removal<span class='mt-1 block text-[11px] font-normal leading-5 text-[#65766f]'>Manual hacked-site investigation and cleanup.</span></a><a href='/blacklist-removal/' class='block py-3 text-sm font-bold'>Blacklist recovery<span class='mt-1 block text-[11px] font-normal leading-5 text-[#65766f]'>Browser and antivirus warning support.</span></a></div></section>
      {relatedPosts.length > 0 && <section class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-5'><h2 class='editorial-heading text-xl font-semibold'>Related {label.toLowerCase()}</h2><div class='mt-3 divide-y divide-[#d7ddd7]'>{relatedPosts.map((related) => <a href={`/${rootSlug}/${related.slug}/`} class='block py-3 text-sm font-bold leading-5'><span set:html={related.title} /><time class='mt-1 block text-[10px] font-normal text-[#788780]'>{new Date(related.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></a>)}</div></section>}
    </aside>
  </div>
</NewLayout>

<FreeScanPopup />

<style is:global>
  .article-prose { color: #3f554d; font-size: 1.04rem; line-height: 1.85; }
  .article-prose > *:first-child { margin-top: 0; }
  .article-prose h2, .article-prose h3, .article-prose h4 { color: #17352c !important; font-family: "Source Serif 4 Variable", Georgia, serif; font-weight: 650; letter-spacing: -0.025em; line-height: 1.2; }
  .article-prose h2 { margin: 2.2em 0 0.7em; font-size: 2rem !important; }
  .article-prose h3 { margin: 1.8em 0 0.65em; font-size: 1.55rem !important; }
  .article-prose h4 { margin: 1.5em 0 0.6em; font-size: 1.25rem !important; }
  .article-prose p, .article-prose ul, .article-prose ol, .article-prose blockquote, .article-prose pre, .article-prose table { margin-block: 1.15em; }
  .article-prose ul, .article-prose ol { padding-left: 1.3rem; }
  .article-prose ul { list-style-type: disc; }
  .article-prose ol { list-style-type: decimal; }
  .article-prose li { margin-block: 0.45rem; padding-left: 0.25rem; }
  .article-prose a { color: #1f6b55; font-weight: 650; text-decoration: underline; text-decoration-color: #ed7655; text-underline-offset: 0.2em; }
  .article-prose strong { color: #17352c; }
  .article-prose blockquote { border-left: 4px solid #ed7655; background: #fee5dc; padding: 1.2rem 1.4rem; color: #5b4b45; }
  .article-prose img { height: auto; max-width: 100%; border-radius: 1rem; border: 1px solid #d7ddd7; }
  .article-prose pre { overflow-x: auto; border-radius: 0.8rem; background: #17352c; padding: 1rem; color: #eff8f4; }
  .article-prose :not(pre) > code { border-radius: 0.3rem; background: #dcece5; padding: 0.15rem 0.35rem; color: #164a3c; font-size: 0.88em; }
  .article-prose table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  .article-prose th, .article-prose td { border: 1px solid #d7ddd7; padding: 0.65rem; }
  .article-prose th { background: #dcece5; color: #17352c; }
  .article-prose [style*='color: #000'], .article-prose [style*='color:#000'] { color: #3f554d !important; }
  @media (max-width: 640px) { .article-prose { font-size: 1rem; } .article-prose h2 { font-size: 1.65rem !important; } .article-prose h3 { font-size: 1.35rem !important; } }
</style>
