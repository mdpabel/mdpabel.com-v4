---
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { WordPressPost } from '../../lib/wordpress';

interface Props {
  posts: WordPressPost[];
  rootSlug: string;
  label: string;
  title: string;
  description: string;
  seoTitle: string;
  currentPage: number;
  totalPages: number;
}

const { posts, rootSlug, label, title, description, seoTitle, currentPage, totalPages } = Astro.props;
const path = currentPage === 1 ? `/${rootSlug}/` : `/${rootSlug}/${currentPage}/`;
const absoluteUrl = `https://www.mdpabel.com${path}`;
const schema = [
  { '@type': 'CollectionPage', '@id': `${absoluteUrl}#webpage`, url: absoluteUrl, name: seoTitle, description, isPartOf: { '@id': 'https://www.mdpabel.com/#website' }, mainEntity: { '@id': `${absoluteUrl}#items` } },
  { '@type': 'ItemList', '@id': `${absoluteUrl}#items`, name: title, itemListElement: posts.map((post, index) => ({ '@type': 'ListItem', position: index + 1 + (currentPage - 1) * 10, name: post.title.replace(/<[^>]+>/g, ''), url: `https://www.mdpabel.com/${rootSlug}/${post.slug}/` })) },
  { '@type': 'BreadcrumbList', '@id': `${absoluteUrl}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.mdpabel.com/' }, { '@type': 'ListItem', position: 2, name: label, item: `https://www.mdpabel.com/${rootSlug}/` }] },
];
---

<NewLayout title={seoTitle} description={description} path={path} schema={schema}>
  <section class='border-b border-[#d7ddd7] py-16 md:py-24'>
    <div class='new-shell'><Breadcrumbs items={[{ label }]} /><div class='mt-10 grid items-end gap-10 lg:grid-cols-[1.1fr_0.65fr]'><div><p class='mb-4 text-xs font-extrabold uppercase tracking-[0.16em] text-[#1f6b55]'>{label} · Field-tested knowledge</p><h1 class='editorial-heading text-5xl font-semibold leading-[0.96] md:text-7xl'>{title}</h1></div><p class='text-base leading-8 text-[#52665f]'>{description}</p></div></div>
  </section>
  <section class='py-20 md:py-28'>
    <div class='new-shell'>
      {posts.length > 0 ? <div class='grid gap-5 md:grid-cols-2 lg:grid-cols-3'>{posts.map((post, index) => {
        const featured = index === 0 && currentPage === 1;
        return <article class:list={['group flex min-h-[360px] flex-col overflow-hidden rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] transition hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#17352c]/10', featured && 'md:col-span-2 lg:grid lg:min-h-[420px] lg:grid-cols-[1.08fr_0.92fr]']}><a href={`/${rootSlug}/${post.slug}/`} class:list={['block aspect-[16/10] overflow-hidden bg-[#dcece5]', featured && 'lg:h-full lg:min-h-[420px] lg:aspect-auto']}>{post.featuredImage ? <img src={post.featuredImage.url} alt={post.featuredImage.alt || ''} width='720' height='450' loading='lazy' class='h-full w-full object-cover transition duration-500 group-hover:scale-105' /> : <div class='grid h-full min-h-[220px] place-items-center text-xs font-extrabold uppercase tracking-[0.18em] text-[#1f6b55]'>MD Pabel · {label}</div>}</a><div class:list={['flex flex-1 flex-col p-6', featured && 'lg:p-8']}><div class='flex items-center justify-between gap-4 text-[10px] font-bold uppercase tracking-wider text-[#788780]'><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time><span>0{index + 1 + (currentPage - 1) * 10}</span></div><h2 class:list={['editorial-heading mt-6 text-2xl font-semibold leading-tight', featured && 'lg:text-3xl']}><a href={`/${rootSlug}/${post.slug}/`}><span set:html={post.title} /></a></h2>{post.excerpt && <p class:list={['mt-4 line-clamp-3 text-sm leading-7 text-[#52665f]', featured && 'lg:line-clamp-5']} set:html={post.excerpt} />}<a href={`/${rootSlug}/${post.slug}/`} class='mt-auto inline-flex items-center gap-2 pt-7 text-xs font-bold'>Read {label.toLowerCase()} <ArrowUpRight class='h-4 w-4' /></a></div></article>;
      })}</div> : <div class='rounded-3xl border border-[#d7ddd7] bg-[#fffdf8] p-10 text-center'><h2 class='editorial-heading text-3xl font-semibold'>The archive is being synchronized.</h2><p class='mt-3 text-sm text-[#52665f]'>Published entries will appear here when the WordPress content source is available during the build.</p></div>}
      {totalPages > 1 && <nav aria-label='Pagination' class='mt-12 flex items-center justify-between border-t border-[#d7ddd7] pt-7'><span>{currentPage > 1 ? <a href={currentPage === 2 ? `/${rootSlug}/` : `/${rootSlug}/${currentPage - 1}/`} class='inline-flex items-center gap-2 text-sm font-bold'><ArrowLeft class='h-4 w-4' />Previous</a> : <span />}</span><span class='text-xs font-bold text-[#788780]'>Page {currentPage} of {totalPages}</span><span>{currentPage < totalPages ? <a href={`/${rootSlug}/${currentPage + 1}/`} class='inline-flex items-center gap-2 text-sm font-bold'>Next<ArrowRight class='h-4 w-4' /></a> : <span />}</span></nav>}
    </div>
  </section>
</NewLayout>
