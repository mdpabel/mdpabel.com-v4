---
import {
  ArrowUpRight,
  Check,
  Clock3,
  Mail,
  MessageCircle,
} from '@lucide/astro';
import NewLayout from '../layouts/NewLayout.astro';
import Breadcrumbs from '../components/new/Breadcrumbs.astro';

const wpApiUrl = import.meta.env.PUBLIC_WORDPRESS_API_URL;
const formId = '1513';
const whatsappUrl = `https://wa.me/8801323390163?text=${encodeURIComponent('Hi, I need help with my website. URL: Issue or goal: Budget:')}`;
const title = 'Hire MD Pabel | WordPress Security & Website Development';
const description =
  'Contact MD Pabel for WordPress malware removal, maintenance, error fixing, blacklist recovery, or WordPress, Next.js, and Astro development.';
const url = 'https://www.mdpabel.com/hire-me/';
const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    mainEntity: { '@id': 'https://www.mdpabel.com/about/#person' },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.mdpabel.com/',
      },
      { '@type': 'ListItem', position: 2, name: 'Hire MD Pabel', item: url },
    ],
  },
];

const inputClass =
  'w-full rounded-xl border border-[#cbd4cf] bg-[#fffdf8] px-4 py-3 text-sm outline-none transition focus:border-[#1f6b55] focus:ring-4 focus:ring-[#1f6b55]/10';
---

<NewLayout
  title={title}
  description={description}
  path='/hire-me/'
  schema={schema}>
  <section class='py-16 md:py-24'>
    <div class='new-shell'>
      <Breadcrumbs items={[{ label: 'Hire Me' }]} /><div
        class='items-start gap-12 lg:gap-24 grid lg:grid-cols-[0.8fr_1.2fr] mt-10'>
        <div class='lg:top-8 lg:sticky'>
          <p
            class='mb-4 font-extrabold text-[#1f6b55] text-xs uppercase tracking-[0.16em]'>
            Start with the real situation
          </p><h1
            class='font-semibold text-5xl md:text-7xl leading-[0.96] editorial-heading'>
            Tell me what happened—or what you want to build.
          </h1><p class='mt-7 text-[#52665f] text-lg leading-8'>
            Share the website URL, the symptom or goal, and any useful deadline.
            I’ll review the context and reply with the most practical next step.
          </p><div class='gap-3 grid mt-9 font-semibold text-sm'>
            {
              [
                'Direct communication with MD Pabel',
                'No obligation from the initial inquiry',
                'Confidential access handling',
                'Worldwide remote support',
              ].map((item) => (
                <span class='flex gap-3'>
                  <span class='place-items-center grid bg-[#dcece5] rounded-full w-6 h-6'>
                    <Check class='w-3.5 h-3.5 text-[#1f6b55]' />
                  </span>
                  {item}
                </span>
              ))
            }
          </div><div class='gap-3 grid sm:grid-cols-2 lg:grid-cols-1 mt-10'>
            <a
              href={whatsappUrl}
              target='_blank'
              rel='noopener noreferrer'
              class='flex items-center gap-3 bg-[#fffdf8] p-4 border border-[#d7ddd7] rounded-2xl'
              ><MessageCircle class='w-5 h-5 text-[#1f6b55]' /><span
                class='text-[#52665f] text-xs'
                ><strong class='block text-[#17352c] text-sm'>WhatsApp</strong
                >Send a short problem summary</span
              ><ArrowUpRight class='ml-auto w-4 h-4' /></a
            ><a
              href='mailto:support@mdpabel.com'
              class='flex items-center gap-3 bg-[#fffdf8] p-4 border border-[#d7ddd7] rounded-2xl'
              ><Mail class='w-5 h-5 text-[#1f6b55]' /><span
                class='text-[#52665f] text-xs'
                ><strong class='block text-[#17352c] text-sm'>Email</strong
                >support@mdpabel.com</span
              ><ArrowUpRight class='ml-auto w-4 h-4' /></a
            >
          </div>
        </div>
        <div
          class='relative bg-[#fffdf8] shadow-[#17352c]/8 shadow-2xl p-6 md:p-9 border border-[#d7ddd7] rounded-3xl'>
          <div
            id='success-message'
            class='hidden z-10 absolute inset-0 flex-col justify-center items-center bg-[#fffdf8] p-8 rounded-3xl text-center'>
            <span
              class='place-items-center grid bg-[#dcece5] rounded-full w-16 h-16 text-[#1f6b55]'
              ><Check class='w-7 h-7' /></span
            ><h2 class='mt-5 font-semibold text-3xl editorial-heading'>
              Your inquiry was sent.
            </h2><p class='mt-3 text-[#52665f] text-sm'>
              I’ll review the details and reply as soon as possible.
            </p><button
              id='reset-form-btn'
              class='mt-6 font-bold text-[#1f6b55] text-sm'
              >Send another message</button
            >
          </div><div class='mb-7'>
            <h2 class='font-semibold text-3xl editorial-heading'>
              Project or support inquiry
            </h2><p class='flex items-center gap-2 mt-2 text-[#65766f] text-xs'>
              <Clock3 class='w-4 h-4' />Usually replies within one business day
            </p>
          </div><form
            id='hire-me-form'
            class='gap-5 grid'
            novalidate
            data-wp-url={wpApiUrl}
            data-form-id={formId}>
            <div class='gap-5 grid sm:grid-cols-2'>
              <label class='gap-2 grid font-bold text-xs'
                >Your name<input
                  id='your-name'
                  name='your-name'
                  class={inputClass}
                  placeholder='Name'
                  autocomplete='name'
                  required
                /></label
              ><label class='gap-2 grid font-bold text-xs'
                >Email address<input
                  id='your-email'
                  name='your-email'
                  type='email'
                  class={inputClass}
                  placeholder='you@company.com'
                  autocomplete='email'
                  required
                /></label
              >
            </div><label class='gap-2 grid font-bold text-xs'
              >What do you need help with?<select
                id='selected-service'
                name='selected-service'
                class={inputClass}
                required
                ><option value=''>Select a service</option><option
                  value='malware-removal'>WordPress malware removal</option
                ><option value='wordpress-maintenance'
                  >WordPress maintenance</option
                ><option value='wordpress-error-fixing'
                  >WordPress error fixing</option
                ><option value='blacklist-removal'>Blacklist removal</option
                ><option value='website-development'>Website development</option
                ><option value='other'>Something else</option></select
              ></label
            ><label class='gap-2 grid font-bold text-xs'
              >Website URL<input
                id='website-url'
                name='website-url'
                type='url'
                class={inputClass}
                placeholder='https://example.com'
              /></label
            ><label class='gap-2 grid font-bold text-xs'
              >Budget or expected range<input
                id='budget'
                name='budget'
                class={inputClass}
                placeholder='Optional, but helpful'
              /></label
            ><label class='gap-2 grid font-bold text-xs'
              >What happened or what should be built?<textarea
                id='description'
                name='description'
                class={`${inputClass} min-h-36 resize-y`}
                placeholder='Include the symptoms, goal, deadline, and anything already tried.'
                required></textarea></label
            ><p
              id='general-error'
              class='hidden bg-[#fee5dc] p-3 rounded-xl text-[#9f432c] text-sm'>
              Please check the required fields or use WhatsApp if the form does
              not send.
            </p><button
              id='submit-btn'
              type='submit'
              class='inline-flex justify-center items-center gap-2 bg-[#1f6b55] hover:bg-[#164a3c] px-6 py-3.5 rounded-full font-bold text-white text-sm transition'
              >Send inquiry <ArrowUpRight class='w-4 h-4' /></button
            ><p class='text-[#788780] text-[11px] text-center leading-5'>
              Do not send passwords in this form. Secure access can be arranged
              after the scope is confirmed.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</NewLayout>

<script>
  const form = document.getElementById(
    'hire-me-form',
  ) as HTMLFormElement | null;
  const submitButton = document.getElementById(
    'submit-btn',
  ) as HTMLButtonElement | null;
  const successMessage = document.getElementById('success-message');
  const errorMessage = document.getElementById('general-error');
  const resetButton = document.getElementById('reset-form-btn');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMessage?.classList.add('hidden');
    const formData = new FormData(form);
    const name = String(formData.get('your-name') || '').trim();
    const email = String(formData.get('your-email') || '').trim();
    const service = String(formData.get('selected-service') || '');
    const details = String(formData.get('description') || '').trim();

    if (
      name.length < 2 ||
      !/^\S+@\S+\.\S+$/.test(email) ||
      !service ||
      details.length < 10
    ) {
      errorMessage?.classList.remove('hidden');
      return;
    }

    const apiUrl = form.dataset.wpUrl;
    const formId = form.dataset.formId;
    if (!apiUrl || !formId) {
      errorMessage?.classList.remove('hidden');
      return;
    }

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
    }
    formData.append('_wpcf7', formId);
    formData.append('_wpcf7_version', '6.1.2');
    formData.append('_wpcf7_locale', 'en_US');
    formData.append('_wpcf7_unit_tag', `wpcf7-f${formId}-p0-o1`);

    try {
      const response = await fetch(
        `${apiUrl}/wp-json/contact-form-7/v1/contact-forms/${formId}/feedback`,
        { method: 'POST', body: formData },
      );
      const result = await response.json();
      if (result.status !== 'mail_sent')
        throw new Error(result.message || 'Submission failed');
      successMessage?.classList.remove('hidden');
      successMessage?.classList.add('flex');
    } catch {
      errorMessage?.classList.remove('hidden');
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Send inquiry';
      }
    }
  });

  resetButton?.addEventListener('click', () => {
    successMessage?.classList.add('hidden');
    successMessage?.classList.remove('flex');
    form?.reset();
  });
</script>
