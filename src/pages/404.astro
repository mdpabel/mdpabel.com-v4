---
import NewLayout from '../layouts/NewLayout.astro';
---
<NewLayout title='Page Not Found | MD Pabel' description='The requested page could not be found.' path='/404/' noindex={true}><section class='grid min-h-[65vh] place-items-center px-5 py-20 text-center'><div><p class='text-xs font-extrabold uppercase tracking-[.2em] text-[#b74e32]'>Error 404</p><h1 class='editorial-heading mt-4 font-semibold'>This page has moved or never existed.</h1><p class='mx-auto mt-5 max-w-xl leading-7 text-[#52665f]'>Try the services page, browse the security guides, or tell me what WordPress problem brought you here.</p><div class='mt-8 flex flex-wrap justify-center gap-3'><a href='/services/' class='rounded-full bg-[#17352c] px-6 py-3 text-sm font-bold text-white'>Explore services</a><a href='/hire-me/' class='rounded-full border border-[#17352c] px-6 py-3 text-sm font-bold'>Contact MD Pabel</a></div></div></section></NewLayout>
