---
import { ArrowRight, ArrowUpRight, Braces, Check, Code2, Layers3, Rocket, ShieldCheck, Sparkles } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from '../../components/new/Breadcrumbs.astro';

const capabilities = [
  { name: 'WordPress development', href: '/website-development/wordpress-development/', icon: Layers3, label: 'CMS and commerce', description: 'Custom WordPress builds, WooCommerce, theme and plugin work, migrations, performance, and secure ongoing ownership.', best: 'Content-led businesses, service sites, stores, and teams that need familiar editing.' },
  { name: 'Next.js development', href: '/website-development/nextjs-development/', icon: Braces, label: 'Full-stack applications', description: 'Fast React interfaces, dashboards, portals, APIs, authentication, databases, and headless content architectures.', best: 'Products and workflows that need application behavior beyond a traditional website.' },
  { name: 'Astro development', href: '/website-development/astro-development/', icon: Rocket, label: 'Content performance', description: 'Lean marketing sites, documentation, publications, and content platforms with excellent static performance.', best: 'SEO-focused websites where content speed and low JavaScript are priorities.' },
  { name: 'AI and vibe-coded projects', href: '/website-development/ai-vibe-coding/', icon: Sparkles, label: 'Build, audit, harden', description: 'Turn AI-assisted prototypes into maintainable products through architecture review, bug fixing, security, testing, and deployment.', best: 'Founders who moved quickly with AI and now need an experienced engineer to make it reliable.' },
];

const faqs = [
  { q: 'Which platform should I choose for my website?', a: 'WordPress is often best for editorial control and common business workflows, Astro for content-first performance, and Next.js for interactive applications. The decision should follow the content model, integrations, editing team, and product requirements—not a preferred tool.' },
  { q: 'Can you improve an existing website instead of rebuilding it?', a: 'Yes. A focused audit may show that performance, UX, technical SEO, security, or maintainability can be improved without replacing the entire platform.' },
  { q: 'Do you work with websites created using AI or vibe coding?', a: 'Yes. I can review AI-generated code, identify security and architecture risks, fix unstable behavior, add tests, improve deployment, and continue development without discarding useful work.' },
  { q: 'Do you provide design as well as development?', a: 'Yes, for website and product-interface work. The design process focuses on information hierarchy, conversion paths, brand character, responsive behavior, and accessible interaction—not only visual decoration.' },
];
const title = 'Website Development Services | WordPress, Next.js, Astro & AI';
const description = 'Custom website development with WordPress, Next.js, Astro, and AI-assisted workflows. Strategy, UI, performance, security, integrations, and long-term maintainability.';
const url = 'https://www.mdpabel.com/website-development/';
const schema = [
  { '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description, about: { '@id': `${url}#service` } },
  { '@type': 'Service', '@id': `${url}#service`, name: 'Website Development Services', serviceType: 'WordPress, Next.js, Astro, and AI-assisted website development', provider: { '@id': 'https://www.mdpabel.com/about/#person' }, areaServed: 'Worldwide', hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Website development capabilities', itemListElement: capabilities.map((item) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: item.name, url: `https://www.mdpabel.com${item.href}` } })) } },
  { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.mdpabel.com/' }, { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.mdpabel.com/services/' }, { '@type': 'ListItem', position: 3, name: 'Website Development', item: url }] },
  { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })) },
];
---

<NewLayout title={title} description={description} path='/website-development/' schema={schema}>
  <section class='relative overflow-hidden border-b border-[#d7ddd7] py-16 md:py-24'><div class='absolute right-[-8rem] top-[-10rem] h-[28rem] w-[28rem] rounded-full border-[5rem] border-[#dcece5] opacity-80'></div><div class='new-shell relative'><Breadcrumbs items={[{ label: 'Services', href: '/services/' }, { label: 'Website Development' }]} /><div class='mt-10 grid items-end gap-12 lg:grid-cols-[1.2fr_0.6fr]'><div><p class='mb-4 text-xs font-extrabold uppercase tracking-[0.16em] text-[#1f6b55]'>Design, engineering, and ownership</p><h1 class='editorial-heading text-5xl font-semibold leading-[0.95] md:text-7xl'>The right website stack for the work it needs to do.</h1><p class='mt-7 max-w-3xl text-lg leading-8 text-[#52665f]'>I design and build distinct, fast, secure websites and applications with WordPress, Next.js, Astro, and carefully managed AI-assisted development.</p><a href='/hire-me/' class='mt-8 inline-flex items-center gap-2 rounded-full bg-[#1f6b55] px-6 py-3.5 text-sm font-bold text-white'>Discuss your project <ArrowRight class='h-4 w-4' /></a></div><div class='grid rotate-1 gap-3 rounded-[2rem_0.75rem_2rem_0.75rem] bg-[#17352c] p-6 text-white'><span class='text-[10px] font-bold uppercase tracking-[0.15em] text-[#a9d6c4]'>Every build includes</span>{['Responsive interface', 'Technical SEO foundation', 'Performance planning', 'Security-conscious implementation', 'Analytics-ready structure', 'Clear handover'].map((item) => <span class='flex gap-2 text-sm'><Check class='h-4 w-4 text-[#ed7655]' />{item}</span>)}</div></div></div></section>
  <section class='py-20 md:py-28'><div class='new-shell'><div class='max-w-4xl'><p class='mb-3 text-xs font-extrabold uppercase tracking-[0.15em] text-[#1f6b55]'>Capabilities</p><h2 class='editorial-heading text-4xl font-semibold md:text-6xl'>One technology is not the answer to every website.</h2><p class='mt-5 max-w-3xl leading-8 text-[#52665f]'>The platform is selected around editing, content, integrations, traffic, application behavior, team skills, and the cost of owning it after launch.</p></div><div class='mt-12 grid gap-4 lg:grid-cols-2'>{capabilities.map((item, index) => <a href={item.href} class:list={['group rounded-3xl border border-[#d7ddd7] bg-[#fffdf8] p-7 transition hover:-translate-y-1 hover:shadow-2xl hover:shadow-[#17352c]/10', index === 0 && 'lg:row-span-2 lg:flex lg:flex-col lg:justify-end lg:bg-[#dcece5]']}><div class='grid h-12 w-12 place-items-center rounded-[50%_50%_50%_14%] bg-[#17352c] text-white'><item.icon class='h-5 w-5' /></div><span class='mt-10 text-[10px] font-extrabold uppercase tracking-[0.14em] text-[#ed7655]'>{item.label}</span><h3 class='editorial-heading mt-3 text-3xl font-semibold'>{item.name}</h3><p class='mt-4 text-sm leading-7 text-[#52665f]'>{item.description}</p><div class='mt-6 border-t border-[#17352c]/10 pt-5'><span class='text-[10px] font-bold uppercase tracking-wider text-[#75857e]'>Best when</span><p class='mt-2 text-xs leading-6 text-[#52665f]'>{item.best}</p></div><span class='mt-6 flex items-center gap-2 text-xs font-bold'>Explore capability <ArrowUpRight class='h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1' /></span></a>)}</div></div></section>
  <section class='bg-[#17352c] py-20 text-white md:py-28'><div class='new-shell grid gap-14 lg:grid-cols-[0.8fr_1.2fr]'><div><ShieldCheck class='h-9 w-9 text-[#ed7655]' /><h2 class='editorial-heading mt-6 text-4xl font-semibold md:text-5xl'>AI can accelerate a build. It does not own the outcome.</h2><p class='mt-5 leading-8 text-[#c9d9d2]'>AI-assisted development still needs product judgment, architecture, secure data handling, accessibility, testing, observability, and a person who can debug what the model produced.</p></div><div class='grid gap-px overflow-hidden rounded-2xl bg-white/15 sm:grid-cols-2'>{['Architecture and code review', 'Authentication and authorization', 'Secret and environment handling', 'Database and API validation', 'Responsive and accessible UI', 'Automated and manual testing', 'Performance and bundle review', 'Deployment and recovery planning'].map((item) => <div class='flex gap-3 bg-[#17352c] p-5 text-sm font-semibold'><Code2 class='h-4 w-4 shrink-0 text-[#ed7655]' />{item}</div>)}</div></div></section>
  <section class='py-20 md:py-28'><div class='new-shell grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24'><div><h2 class='editorial-heading text-4xl font-semibold md:text-5xl'>Development questions.</h2></div><div class='divide-y divide-[#d7ddd7] border-y border-[#d7ddd7]'>{faqs.map((faq) => <details class='group py-5'><summary class='flex cursor-pointer list-none justify-between gap-4 font-bold'>{faq.q}<span class='text-[#ed7655] group-open:rotate-45'>+</span></summary><p class='pt-4 text-sm leading-7 text-[#52665f]'>{faq.a}</p></details>)}</div></div></section>
</NewLayout>
