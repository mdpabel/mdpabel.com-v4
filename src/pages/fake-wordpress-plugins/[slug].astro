---
import { ShieldAlert } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from '../../components/new/Breadcrumbs.astro';
import { wordpress } from '../../lib/wordpress';
export async function getStaticPaths(){const items=await wordpress.getAllPosts({postType:'fake_plugin'}).catch(()=>[]);return items.map(plugin=>({params:{slug:plugin.slug},props:{plugin}}));}
const {plugin}=Astro.props;const a=plugin.acf||{};const display=a.plugin_display_name||plugin.title.replace(/<[^>]+>/g,'');const description=a.quick_answer||`Defensive analysis, indicators, symptoms, and removal guidance for the ${display} fake WordPress plugin.`;const path=`/fake-wordpress-plugins/${plugin.slug}/`;const split=(v:string)=>v?v.split('\n').map(x=>x.trim()).filter(Boolean):[];const symptoms=split(a.visible_symptoms);const files=[...split(a.dropped_files),...split(a.companion_files)];const schema=[{'@type':'TechArticle',headline:display,description,url:`https://www.mdpabel.com${path}`,author:{'@type':'Person',name:'MD Pabel',url:'https://www.mdpabel.com/about/'},datePublished:plugin.date,dateModified:plugin.modified},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://www.mdpabel.com/'},{'@type':'ListItem',position:2,name:'Fake WordPress Plugins',item:'https://www.mdpabel.com/fake-wordpress-plugins/'},{'@type':'ListItem',position:3,name:display,item:`https://www.mdpabel.com${path}`}]}];
---
<NewLayout title={`${display} Fake WordPress Plugin: Analysis & Removal`} description={description} path={path} type='article' schema={schema}>
<article class='py-12 md:py-18'><div class='new-shell max-w-5xl'><Breadcrumbs items={[{label:'Fake plugins',href:'/fake-wordpress-plugins/'},{label:display}]}/><header class='mt-9 border-b border-[#d7ddd7] pb-9'><p class='mb-4 flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.16em] text-[#b74e32]'><ShieldAlert class='h-4 w-4'/>Malware advisory {a.severity&&`· ${a.severity} severity`}</p><h1 class='editorial-heading font-semibold'>{display}</h1><p class='mt-5 max-w-3xl text-lg leading-8 text-[#52665f]'>{description}</p></header><div class='mt-10 grid gap-8 lg:grid-cols-[1fr_.42fr]'><div class='space-y-10'>{a.primary_purpose&&<section><h2 class='editorial-heading text-3xl font-semibold'>Behavior and purpose</h2><p class='mt-4 leading-8 text-[#52665f]'>{a.primary_purpose}</p></section>}{a.removal_steps&&<section><h2 class='editorial-heading text-3xl font-semibold'>Defensive removal notes</h2><div class='research-prose mt-4' set:html={a.removal_steps}/></section>}{a.malicious_code_example&&<section><h2 class='editorial-heading text-3xl font-semibold'>Observed code indicator</h2><p class='mt-2 text-sm text-[#52665f]'>Treat this as an investigation clue, not proof by itself.</p><pre class='mt-4 overflow-auto rounded-2xl bg-[#17352c] p-5 text-sm text-white'><code>{a.malicious_code_example}</code></pre></section>}</div><aside class='space-y-4'>{[["Plugin folder",a.plugin_folder_name],["Main file",a.plugin_main_file],["Malware family",a.malware_family],["Fake author",a.fake_author]].filter(x=>x[1]).map(([k,v])=><div class='rounded-xl border border-[#d7ddd7] bg-[#fffdf8] p-5'><strong class='block text-xs uppercase tracking-wider text-[#788780]'>{k}</strong><code class='mt-2 block break-all text-sm'>{v}</code></div>)}{symptoms.length>0&&<div class='rounded-xl bg-[#fee5dc] p-5'><h2 class='font-bold'>Visible symptoms</h2><ul class='mt-3 list-disc space-y-2 pl-5 text-sm'>{symptoms.map(s=><li>{s}</li>)}</ul></div>}{files.length>0&&<div class='rounded-xl border border-[#d7ddd7] p-5'><h2 class='font-bold'>Associated files</h2><ul class='mt-3 space-y-2'>{files.map(f=><li><code class='break-all text-xs'>{f}</code></li>)}</ul></div>}</aside></div></div></article>
</NewLayout><style is:global>.research-prose{line-height:1.8;color:#52665f}.research-prose p,.research-prose ul,.research-prose ol{margin:1rem 0}.research-prose ul,.research-prose ol{padding-left:1.4rem}</style>
