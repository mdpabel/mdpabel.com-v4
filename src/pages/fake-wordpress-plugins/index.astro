---
import { ShieldAlert, ArrowUpRight } from '@lucide/astro';
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from '../../components/new/Breadcrumbs.astro';
import { wordpress } from '../../lib/wordpress';
const plugins=await wordpress.getAllPosts({postType:'fake_plugin'}).catch(()=>[]);
const path='/fake-wordpress-plugins/'; const url=`https://www.mdpabel.com${path}`;
const description='A forensic reference of malicious and fake WordPress plugins found during hacked-site investigations, including symptoms, file indicators, behavior, and defensive removal notes.';
const schema=[{'@type':'CollectionPage',name:'Fake WordPress Plugin Database',description,url},{'@type':'ItemList',itemListElement:plugins.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.acf?.plugin_display_name||p.title,url:`${url}${p.slug}/`}))}];
---
<NewLayout title='Fake WordPress Plugin Database | Malware Research' description={description} path={path} schema={schema}>
<section class='border-b border-[#d7ddd7] py-14 md:py-20'><div class='new-shell'><Breadcrumbs items={[{label:'Fake WordPress plugins'}]}/><div class='mt-9 max-w-4xl'><p class='mb-4 flex items-center gap-2 text-xs font-extrabold uppercase tracking-[.16em] text-[#b74e32]'><ShieldAlert class='h-4 w-4'/>Threat intelligence</p><h1 class='editorial-heading font-semibold'>Fake WordPress Plugin Database</h1><p class='mt-6 max-w-3xl text-lg leading-8 text-[#52665f]'>{description}</p></div></div></section>
<section class='py-16 md:py-24'><div class='new-shell'>{plugins.length?<ol class='grid gap-4'>{plugins.map((p,i)=>{const a=p.acf||{};return <li><a href={`/fake-wordpress-plugins/${p.slug}/`} class='group flex items-center gap-5 rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-5 transition hover:-translate-y-1 hover:shadow-lg'><span class='font-mono text-xs text-[#788780]'>{String(i+1).padStart(3,'0')}</span><span class='min-w-0 flex-1'><strong class='editorial-heading block text-xl' set:html={a.plugin_display_name||p.title}/><span class='mt-1 flex flex-wrap gap-2 text-xs text-[#52665f]'>{a.plugin_folder_name&&<code>/{a.plugin_folder_name}/</code>}{a.malware_family&&<span>· {a.malware_family}</span>}</span></span><ArrowUpRight class='h-5 w-5 shrink-0'/></a></li>})}</ol>:<div class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-8'><h2 class='editorial-heading text-3xl'>The research index is synchronizing.</h2><p class='mt-3 text-sm text-[#52665f]'>Published entries appear when the WordPress research source is available during the build.</p></div>}</div></section>
</NewLayout>
