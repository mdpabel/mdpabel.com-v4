---
import {
  ArrowRight,
  ArrowUpRight,
  Check,
  Search,
  ShieldCheck,
} from '@lucide/astro';
import NewLayout from '../layouts/NewLayout.astro';
import Breadcrumbs from '../components/new/Breadcrumbs.astro';

const vendors = [
  [
    'Google Safe Browsing',
    'Chrome and search security warnings',
    '/google-blacklist-removal-service/',
  ],
  [
    'McAfee WebAdvisor',
    'Web reputation ratings and browser warnings',
    '/mcafee-blacklist-removal/',
  ],
  ['Norton Safe Web', 'Norton website safety and reputation ratings', null],
  [
    'Avast and AVG',
    'Web Shield URL and threat warnings',
    '/avast-blacklist-removal/',
  ],
  [
    'Microsoft Defender SmartScreen',
    'Microsoft Edge reputation-based URL warnings',
    null,
  ],
  [
    'Trend Micro Site Safety',
    'Trend Micro URL reputation classifications',
    null,
  ],
  ['Kaspersky OpenTIP', 'Kaspersky domain and web-address reputation', null],
  ['Bitdefender Link Checker', 'Bitdefender URL safety classifications', null],
  ['ESET web protection', 'ESET potentially dangerous website blocks', null],
  [
    'Malwarebytes Browser Guard',
    'Browser-level scam, malware, and reputation blocks',
    null,
  ],
  ['Sucuri SiteCheck', 'Remote malware and blacklist scan results', null],
  ['Quttera', 'Website malware and threat classifications', null],
];

const faqs = [
  {
    q: 'Can every blacklist warning be removed?',
    a: 'A warning can be reviewed after the underlying security or reputation issue is resolved, but the final classification belongs to the vendor. No legitimate service can guarantee or force a vendor decision.',
  },
  {
    q: 'Should I request a review before cleaning the site?',
    a: 'No. Requesting a review while malicious content, redirects, phishing pages, or persistence remains can lead to a failed review and a longer recovery.',
  },
  {
    q: 'Why is one vendor still blocking the site after Google is clear?',
    a: 'Vendors use different data, scanning schedules, categories, and review processes. Clearing one list does not automatically update every other reputation provider.',
  },
  {
    q: 'How long does blacklist removal take?',
    a: 'Cleanup can often be completed quickly, but review timing is controlled by each vendor. Some update automatically after rescanning; others require ownership verification, evidence, or a manual dispute.',
  },
];
const title =
  'Website Blacklist Removal Service | Google, McAfee, Norton & Avast';
const description =
  'Website blacklist removal after malware cleanup, with diagnosis and review support for Google Safe Browsing, McAfee, Norton, Avast, SmartScreen, and other vendors.';
const url = 'https://www.mdpabel.com/blacklist-removal/';
const schema = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    about: { '@id': `${url}#service` },
  },
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: 'Website Blacklist Removal Service',
    serviceType: 'Website security warning and reputation recovery',
    provider: { '@id': 'https://www.mdpabel.com/about/#person' },
    areaServed: 'Worldwide',
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.mdpabel.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://www.mdpabel.com/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Blacklist Removal',
        item: url,
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---

<NewLayout
  title={title}
  description={description}
  path='/blacklist-removal/'
  schema={schema}>
  <section
    class='relative py-16 md:py-24 border-[#d7ddd7] border-b overflow-hidden'>
    <div class='new-shell'>
      <Breadcrumbs
        items={[
          { label: 'Services', href: '/services/' },
          { label: 'Blacklist Removal' },
        ]}
      /><div
        class='items-center gap-12 grid lg:grid-cols-[1.15fr_0.65fr] mt-10'>
        <div>
          <p
            class='mb-4 font-extrabold text-[#1f6b55] text-xs uppercase tracking-[0.16em]'>
            Website reputation recovery
          </p><h1
            class='font-semibold text-5xl md:text-7xl leading-[0.96] editorial-heading'>
            Remove the cause. Then clear the warning.
          </h1><p class='mt-7 max-w-3xl text-[#52665f] text-lg leading-8'>
            I clean the security issue behind website blacklist warnings,
            identify which vendors are flagging the domain, and handle or guide
            the correct review process for each provider.
          </p><a
            href='/hire-me/'
            class='inline-flex items-center gap-2 bg-[#1f6b55] mt-8 px-6 py-3.5 rounded-full font-bold text-white text-sm'
            >Check my website warning <ArrowRight class='w-4 h-4' /></a>
        </div><aside
          class='bg-[#17352c] p-7 rounded-[2rem_0.75rem_2rem_0.75rem] text-white'>
          <Search class='w-7 h-7 text-[#ed7655]' /><h2
            class='mt-6 font-semibold text-3xl editorial-heading'>
            A blacklist is a symptom.
          </h2><p class='mt-4 text-[#c9d9d2] text-sm leading-7'>
            Submitting a review without removing malware, phishing content,
            deceptive pages, or injected redirects does not solve the problem.
          </p><div
            class='gap-3 grid mt-6 pt-6 border-white/15 border-t font-bold text-xs'>
            {
              [
                'Identify the exact vendor',
                'Clean the underlying issue',
                'Verify the website',
                'Submit the correct review',
              ].map((item) => (
                <span class='flex gap-2'>
                  <Check class='w-4 h-4 text-[#ed7655]' />
                  {item}
                </span>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </section>
  <section class='py-20 md:py-28'>
    <div class='new-shell'>
      <div class='max-w-3xl'>
        <p
          class='mb-3 font-extrabold text-[#1f6b55] text-xs uppercase tracking-[0.15em]'>
          Vendor coverage
        </p><h2 class='font-semibold text-4xl md:text-6xl editorial-heading'>
          Security and reputation systems I can investigate.
        </h2><p class='mt-5 text-[#52665f] leading-8'>
          A domain can be clear with one provider and still blocked by another.
          Each result needs to be checked and handled on its own terms.
        </p>
      </div><div class='gap-3 grid sm:grid-cols-2 lg:grid-cols-3 mt-12'>
        {
          vendors.map(([name, detail, href]) =>
            href ? (
              <a
                href={href}
                class='group bg-[#fffdf8] p-5 border border-[#d7ddd7] rounded-2xl transition hover:-translate-y-1'>
                <>
                  <ShieldCheck class='w-5 h-5 text-[#1f6b55]' />
                  <h3 class='mt-5 font-semibold text-xl editorial-heading'>
                    {name}
                  </h3>
                  <p class='mt-2 text-[#52665f] text-xs leading-6'>{detail}</p>
                  <span class='flex items-center gap-2 mt-5 font-bold text-[#ed7655] text-xs'>
                    Focused recovery page <ArrowUpRight class='w-4 h-4' />
                  </span>
                </>
              </a>
            ) : (
              <article class='bg-[#fffdf8] p-5 border border-[#d7ddd7] rounded-2xl'>
                <>
                  <ShieldCheck class='w-5 h-5 text-[#1f6b55]' />
                  <h3 class='mt-5 font-semibold text-xl editorial-heading'>
                    {name}
                  </h3>
                  <p class='mt-2 text-[#52665f] text-xs leading-6'>{detail}</p>
                  <span class='block mt-5 font-bold text-[#8a9892] text-[10px] uppercase tracking-wider'>
                    Included in vendor diagnosis
                  </span>
                </>
              </article>
            ),
          )
        }
      </div>
    </div>
  </section>
  <section class='bg-[#dcece5] py-20'>
    <div class='gap-12 grid lg:grid-cols-[0.8fr_1.2fr] new-shell'>
      <div>
        <p class='font-bold text-[#1f6b55] text-xs uppercase tracking-[0.15em]'>
          Recovery sequence
        </p><h2
          class='mt-3 font-semibold text-4xl md:text-5xl editorial-heading'>
          The order matters.
        </h2>
      </div><ol class='gap-3 grid'>
        {
          [
            'Confirm the warning and affected vendor',
            'Investigate malware, redirects, phishing, and deceptive content',
            'Clean the website and close persistence',
            'Verify externally visible symptoms are gone',
            'Submit the vendor-specific review or dispute',
            'Monitor the classification and document the result',
          ].map((step, index) => (
            <li class='flex gap-4 bg-[#fffdf8] p-4 rounded-xl font-semibold text-sm'>
              <span class='text-[#ed7655] editorial-heading'>0{index + 1}</span>
              {step}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section class='py-20 md:py-28'>
    <div class='gap-14 lg:gap-24 grid lg:grid-cols-[0.7fr_1.3fr] new-shell'>
      <div>
        <h2 class='font-semibold text-4xl md:text-5xl editorial-heading'>
          Blacklist removal questions.
        </h2>
      </div><div class='border-[#d7ddd7] border-y divide-y divide-[#d7ddd7]'>
        {
          faqs.map((faq) => (
            <details class='group py-5'>
              <>
                <summary class='flex justify-between gap-4 font-bold cursor-pointer list-none'>
                  {faq.q}
                  <span class='text-[#ed7655] group-open:rotate-45'>+</span>
                </summary>
                <p class='pt-4 text-[#52665f] text-sm leading-7'>{faq.a}</p>
              </>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</NewLayout>
