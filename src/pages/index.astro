---
import { Image } from 'astro:assets';
import {
  ArrowRight,
  ArrowUpRight,
  BadgeCheck,
  BookOpen,
  Check,
  ChevronRight,
  CircleCheck,
  Clock3,
  Code2,
  Braces,
  Globe2,
  Search,
  ShieldCheck,
  Star,
} from '@lucide/astro';
import '../styles/global.css';
import portrait from '../assets/my-img.png';
import NewHeader from '../components/new/NewHeader.astro';
import NewFooter from '../components/new/NewFooter.astro';
import TawkChat from '../components/new/TawkChat.astro';

const services = [
  {
    number: '01',
    title: 'WordPress malware removal',
    description:
      'Manual hacked-website cleanup for malicious files, hidden backdoors, spam redirects, fake plugins, and database injections.',
    href: '/wordpress-malware-removal/',
    icon: Code2,
    tag: 'Most requested',
  },
  {
    number: '02',
    title: 'Blacklist recovery',
    description:
      'Remove security warnings and restore trust with Google, McAfee, Norton, Avast, and other reputation vendors.',
    href: '/blacklist-removal/',
    icon: Globe2,
    tag: 'Reputation repair',
  },
  {
    number: '03',
    title: 'Error fixing',
    description:
      'Diagnose and repair critical errors, failed updates, plugin conflicts, database issues, and broken WordPress sites.',
    href: '/wordpress-error-fixing/',
    icon: ShieldCheck,
    tag: 'Technical repair',
  },
  {
    number: '04',
    title: 'Website development',
    description:
      'Build and improve maintainable websites with WordPress, Astro, Next.js, and carefully reviewed AI-assisted code.',
    href: '/website-development/',
    icon: Braces,
    tag: 'Build and improve',
  },
];

const cases = [
  {
    metric: '3.45M',
    label: 'spam URLs cleared',
    title: 'Recovering a site from a massive SEO spam infection',
    href: '/case-studies/how-we-cleaned-a-hacked-wordpress-site-from-3-45m-matbet-seo-spam-and-how-you-can-prevent-it/',
  },
  {
    metric: '53,771',
    label: 'infected files removed',
    title: 'Cleaning a defaced WordPress website at scale',
    href: '/case-studies/wordpress-homepage-defaced-gambling-site-case-study/',
  },
  {
    metric: '242,000',
    label: 'spam URLs removed',
    title: 'Reversing a Japanese keyword hack in Google',
    href: '/case-studies/remove-spam-urls-from-google/',
  },
];

const insights = [
  {
    category: 'Field guide',
    title: 'Why WordPress malware keeps coming back after cleanup',
    href: '/blog/why-wordpress-malware-keeps-coming-back-and-how-to-stop-it-forever/',
  },
  {
    category: 'Malware analysis',
    title: 'How to identify and remove hidden WordPress backdoors',
    href: '/blog/i-found-a-hidden-backdoor-in-a-clients-wordpress-site/',
  },
  {
    category: 'Search recovery',
    title: 'A complete guide to the Japanese keyword hack',
    href: '/blog/japanese-keyword-hack-the-complete-guide-to-detection-removal-prevention-in-2025/',
  },
];

const homeTitle =
  'WordPress Malware Removal Expert & Security Specialist | MD Pabel';
const homeDescription =
  'Independent WordPress security specialist with 4,500+ hacked-site cleanups since 2018. Manual malware removal, blacklist recovery, maintenance, and development.';
const homeUrl = 'https://www.mdpabel.com/';
const personId = 'https://www.mdpabel.com/about/#person';
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeUrl}#website`,
      url: homeUrl,
      name: 'MD Pabel',
      alternateName: 'MD Pabel WordPress Security',
      description: homeDescription,
      publisher: { '@id': personId },
      inLanguage: 'en',
    },
    {
      '@type': 'WebPage',
      '@id': `${homeUrl}#webpage`,
      url: homeUrl,
      name: homeTitle,
      description: homeDescription,
      isPartOf: { '@id': `${homeUrl}#website` },
      about: { '@id': personId },
      mainEntity: { '@id': `${homeUrl}#service` },
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'MD Pabel',
      url: 'https://www.mdpabel.com/about/',
      image: 'https://www.mdpabel.com/md-pabel.png',
      jobTitle: 'WordPress Security Specialist and Web Developer',
      sameAs: [
        'https://www.linkedin.com/in/mdpabe1/',
        'https://github.com/mdpabel',
        'https://find-and-update.company-information.service.gov.uk/company/15939565/officers',
      ],
      knowsAbout: [
        'WordPress malware removal',
        'Hacked website recovery',
        'Blacklist removal',
        'WordPress maintenance',
        'WordPress development',
      ],
    },
    {
      '@type': 'Service',
      '@id': `${homeUrl}#service`,
      name: 'WordPress Security and Website Recovery Services',
      serviceType: 'WordPress malware removal and hacked website recovery',
      provider: { '@id': personId },
      areaServed: 'Worldwide',
      url: 'https://www.mdpabel.com/services/',
    },
  ],
};
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <title>{homeTitle}</title>
    <meta name='description' content={homeDescription} />
    <link rel='icon' type='image/png' href='/icon.png' />
    <link rel='canonical' href={new URL('/', Astro.site)} />
    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='MD Pabel' />
    <meta property='og:title' content={homeTitle} />
    <meta property='og:description' content={homeDescription} />
    <meta property='og:url' content={homeUrl} />
    <meta property='og:image' content='https://www.mdpabel.com/md-pabel.png' />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={homeTitle} />
    <meta name='twitter:description' content={homeDescription} />
    <meta name='twitter:image' content='https://www.mdpabel.com/md-pabel.png' />
    <script
      is:inline
      type='application/ld+json'
      set:html={JSON.stringify(homeSchema)}
    />
  </head>

  <body>
    <a class='skip-link' href='#main-content'>Skip to content</a>

    <div class='concept-page'>
      <NewHeader />

      <main id='main-content'>
        <section class='hero'>
          <div class='hero-grid' aria-hidden='true'></div>
          <div class='shell hero-layout'>
            <div class='hero-copy'>
