      </main>

      <NewFooter />
    </div>

    <TawkChat />

    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        const revealItems = document.querySelectorAll('[data-reveal]');

        if (reduceMotion || !('IntersectionObserver' in window)) {
          revealItems.forEach((item) => item.classList.add('is-visible'));
          return;
        }

        document.documentElement.classList.add('has-motion');

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.14, rootMargin: '0px 0px -40px' },
        );

        revealItems.forEach((item) => observer.observe(item));
      })();
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }

  :global(body) {
    margin: 0;
    background: #f7f4ed;
    color: #17352c;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button),
  :global(summary) {
    font: inherit;
  }

  .concept-page {
    --ink: #17352c;
    --ink-soft: #52665f;
    --paper: #f7f4ed;
    --surface: #fffdf8;
    --primary: #1f6b55;
    --primary-deep: #164a3c;
    --primary-pale: #dcece5;
    --secondary: #ed7655;
    --secondary-pale: #fee5dc;
    --line: #d7ddd7;
    min-height: 100vh;
    overflow: hidden;
    background: var(--paper);
  }

  .shell {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-150%);
    border-radius: 0.5rem;
    background: var(--ink);
    padding: 0.75rem 1rem;
    color: white;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: relative;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    backdrop-filter: blur(16px);
  }

  .nav-wrap {
    display: flex;
    min-height: 82px;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 50% 50% 50% 14%;
    background: var(--ink);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .brand-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-copy strong {
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .brand-copy small {
    margin-top: 0.28rem;
    color: var(--ink-soft);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .desktop-nav a {
    position: relative;
    color: #3c554c;
    font-size: 0.88rem;
    font-weight: 650;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    transform: scaleX(0);
    background: var(--secondary);
    content: '';
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
  }

  .nav-cta,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.87rem;
    font-weight: 750;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }

  .nav-cta {
    border-color: var(--ink);
    padding: 0.72rem 1rem;
  }

  .nav-cta:hover {
    transform: translateY(-2px);
    background: var(--ink);
    color: #fff;
  }

  .mobile-nav {
    display: none;
  }

  .hero {
    position: relative;
    padding: 74px 0 84px;
  }

  .hero::before {
    position: absolute;
    top: 18%;
    left: -150px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(31, 107, 85, 0.14);
    border-radius: 50%;
    content: '';
  }

  .hero-grid {
    position: absolute;
    top: 0;
    right: 0;
    width: 48%;
    height: 100%;
    opacity: 0.42;
    background-image:
      linear-gradient(rgba(31, 107, 85, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(31, 107, 85, 0.1) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to left, black 20%, transparent 90%);
  }

  .hero-layout {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-copy {
    animation: hero-copy-in 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .eyebrow,
  .kicker {
    color: var(--primary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.4rem;
  }

  .pulse-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--secondary);
    animation: pulse-soft 2.8s ease-in-out infinite;
  }

  .pulse-dot::after {
    position: absolute;
    inset: -5px;
    border: 1px solid var(--secondary);
    border-radius: inherit;
    content: '';
    opacity: 0.35;
  }

  .hero h1,
  .section h2,
  .final-section h2 {
    margin: 0;
    font-family: 'Source Serif 4 Variable', Georgia, serif;
    font-weight: 620;
    letter-spacing: -0.045em;
  }

