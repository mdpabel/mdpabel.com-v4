                  <span><Search size={15} /> Investigation</span>
                  <span class='status-pill'>Active</span>
                </div>
                <div class='scan-line'><span></span></div>
                <div class='scan-items'>
                  <p><CircleCheck size={16} /> Files & database</p>
                  <p><CircleCheck size={16} /> Backdoor persistence</p>
                  <p><CircleCheck size={16} /> Security hardening</p>
                </div>
              </div>

              <div class='experience-stamp'>
                <span>8+</span>
                <small>years in<br />the field</small>
