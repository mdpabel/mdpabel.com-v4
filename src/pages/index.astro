                <a class='button button-primary' href='/hire-me/'>
                  Tell me what happened
                  <ArrowRight size={18} />
                </a>
                <a class='text-link' href='/wordpress-malware-removal/'>
                  Explore malware removal
                  <ChevronRight size={17} />
                </a>
              </div>

              <div class='trust-row' aria-label='Professional highlights'>
                <div class='avatar-stack' aria-hidden='true'>
                  <span>WP</span><span>SEO</span><span>DB</span>
                </div>
                <p>
                  <strong>4,500+ real cleanups</strong>
                  <span>since 2018 · manual investigation</span>
                </p>
              </div>
            </div>

            <div class='hero-visual'>
              <div class='portrait-frame'>
                <div class='portrait-corner'>Security<br />specialist</div>
