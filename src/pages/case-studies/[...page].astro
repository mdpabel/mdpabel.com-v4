---
import ArchivePage from '../../components/new/ArchivePage.astro';
import { wordpress } from '../../lib/wordpress';

export async function getStaticPaths() {
  const perPage = 10;
  const allPosts = await wordpress.getAllPosts({ postType: 'case-study' });
  const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));
  return Array.from({ length: totalPages }, (_, index) => ({ params: { page: index === 0 ? undefined : String(index + 1) }, props: { posts: allPosts.slice(index * perPage, (index + 1) * perPage), totalPages, currentPage: index + 1 } }));
}
const { posts, totalPages, currentPage } = Astro.props;
const seoTitle = currentPage === 1 ? 'WordPress Malware Removal Case Studies | MD Pabel' : `WordPress Security Case Studies — Page ${currentPage}`;
---
<ArchivePage posts={posts} totalPages={totalPages} currentPage={currentPage} rootSlug='case-studies' label='Case studies' title='Real incidents. Visible recovery evidence.' description='First-hand WordPress malware cleanup, SEO spam recovery, blacklist resolution, and technical repair stories from client work.' seoTitle={seoTitle} />
