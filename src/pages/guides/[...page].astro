---
import ArchivePage from '../../components/new/ArchivePage.astro';
import { wordpress } from '../../lib/wordpress';

export async function getStaticPaths() {
  const perPage = 10;
  const allPosts = await wordpress.getAllPosts({ postType: 'guide' });
  const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));
  return Array.from({ length: totalPages }, (_, index) => ({ params: { page: index === 0 ? undefined : String(index + 1) }, props: { posts: allPosts.slice(index * perPage, (index + 1) * perPage), totalPages, currentPage: index + 1 } }));
}
const { posts, totalPages, currentPage } = Astro.props;
const seoTitle = currentPage === 1 ? 'WordPress Security Guides & Tutorials | MD Pabel' : `WordPress Security Guides — Page ${currentPage}`;
---
<ArchivePage posts={posts} totalPages={totalPages} currentPage={currentPage} rootSlug='guides' label='Guides' title='Step-by-step WordPress security guides.' description='Detailed tutorials for diagnosing WordPress problems, understanding malware, strengthening security, and making safer technical decisions.' seoTitle={seoTitle} />
