---
import {
  ArrowRight,
  BookOpen,
  ExternalLink,
  Microscope,
} from '@lucide/astro';

import NewLayout from '../layouts/NewLayout.astro';
import { books } from '../data/books';

const url = 'https://www.mdpabel.com/books/';
const title = 'WordPress Security Books by MD Pabel';
const description =
  'Browse practical WordPress security books by MD Pabel, built from real malware investigations, cleanup cases, recovery work, and retained evidence.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    mainEntity: { '@id': `${url}#books` },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@type': 'ItemList',
    '@id': `${url}#books`,
    name: 'WordPress security books by MD Pabel',
    numberOfItems: books.length,
    itemListElement: books.map((book, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Book',
        name: `${book.title} ${book.subtitle}`,
        url: new URL(book.details, url).href,
        sameAs: book.stores.map((store) => store.href),
        author: {
          '@type': 'Person',
          '@id': 'https://www.mdpabel.com/about/#person',
          name: 'MD Pabel',
        },
        numberOfPages: book.numberOfPages,
        bookFormat: 'https://schema.org/EBook',
        inLanguage: 'en',
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.mdpabel.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Books',
        item: url,
      },
    ],
  },
];
---

<NewLayout
  {title}
  {description}
  path={url}
  image='/images/book/wordpress-malware-removal-book-social.png'
  {schema}>
  <section class='books-hero relative overflow-hidden border-b border-[#d7ddd7] py-16 md:py-24'>
    <div class='books-grid pointer-events-none absolute inset-0'></div>
    <div class='new-shell relative'>
      <div class='max-w-4xl'>
        <div class='inline-flex items-center gap-2 rounded-full border border-[#1f6b55]/15 bg-white/75 px-3.5 py-2 text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#1f6b55] shadow-sm backdrop-blur'>
          <BookOpen class='h-3.5 w-3.5' />
          Books by MD Pabel
        </div>
        <h1 class='editorial-heading mt-6 max-w-4xl font-semibold'>
          Practical WordPress security books for real incidents.
        </h1>
        <p class='mt-6 max-w-3xl text-lg leading-8 text-[#52665f] md:text-xl'>
          A growing catalog of field guides and focused case studies for investigating,
          cleaning, recovering, and verifying compromised WordPress websites.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby='published-books-title' class='py-16 md:py-24'>
    <div class='new-shell'>
      <div class='flex flex-col gap-4 border-b border-[#d7ddd7] pb-7 sm:flex-row sm:items-end sm:justify-between'>
        <div>
          <p class='text-xs font-extrabold uppercase tracking-[0.16em] text-[#b84e31]'>
            The catalog
          </p>
          <h2 id='published-books-title' class='editorial-heading mt-3 text-3xl font-semibold md:text-4xl'>
            Published books
          </h2>
        </div>
        <span class='w-fit rounded-full bg-[#dcece5] px-4 py-2 text-xs font-extrabold text-[#1f6b55]'>
          {books.length} {books.length === 1 ? 'title' : 'titles'}
        </span>
      </div>

      <div class='book-catalog-grid mt-10 gap-7'>
        {
          books.map((book) => (
            <article class='book-card flex min-w-0 flex-col overflow-hidden rounded-[2rem] border border-[#d7ddd7] bg-[#fffdf8] shadow-sm'>
              <a
                href={book.details}
                class='book-cover-stage group grid min-h-80 place-items-center overflow-hidden p-8'
                aria-label={`Explore ${book.title} ${book.subtitle}`}>
                <img
                  src={book.cover}
                  alt={book.alt}
                  loading='lazy'
                  class='h-auto max-h-[310px] w-auto max-w-[210px] rounded-sm shadow-2xl shadow-[#17352c]/25 transition duration-300 group-hover:-translate-y-1 group-hover:rotate-[-1deg]'
                />
              </a>

              <div class='flex flex-1 flex-col p-6 md:p-8'>
                <p class='text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#b84e31]'>
                  {book.badge}
                </p>
                <h2 class='editorial-heading mt-3 text-3xl font-semibold leading-[1.04]'>
                  {book.title}
                </h2>
                <p class='mt-2 text-sm font-bold leading-6 text-[#1f6b55]'>{book.subtitle}</p>
                <p class='mt-5 text-sm leading-7 text-[#52665f]'>{book.description}</p>

                <div class='mt-5 flex flex-wrap gap-2'>
                  {book.metrics.map((metric) => (
                    <span class='rounded-full border border-[#cdd8d2] bg-[#f7f4ed] px-3 py-1.5 text-[11px] font-extrabold text-[#40574f]'>
                      {metric}
                    </span>
                  ))}
                </div>

                <p class='mt-6 border-l-2 border-[#ed7655] pl-4 text-xs leading-6 text-[#52665f]'>
                  <strong class='text-[#17352c]'>Best for:</strong> {book.bestFor}
                </p>

                <div class='mt-auto pt-7'>
                  <a
                    href={book.details}
                    class='group inline-flex items-center gap-2 rounded-full bg-[#1f6b55] px-5 py-3 text-xs font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-[#164a3c]'>
                    View book details
                    <ArrowRight class='h-4 w-4 transition group-hover:translate-x-0.5' />
                  </a>
                  <div class='mt-4 flex flex-wrap gap-x-4 gap-y-2'>
                    {book.stores.map((store) => (
                      <a
                        href={store.href}
                        target='_blank'
                        rel='noopener'
                        class='inline-flex items-center gap-1.5 text-xs font-extrabold text-[#52665f] transition hover:text-[#b84e31]'>
                        {store.label} <ExternalLink class='h-3.5 w-3.5' />
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class='pb-16 md:pb-24'>
    <div class='new-shell'>
      <div class='research-panel relative overflow-hidden rounded-[2rem] bg-[#17352c] p-8 text-white md:p-12'>
        <div class='relative grid items-center gap-8 lg:grid-cols-[1.2fr_0.8fr]'>
          <div>
            <Microscope class='h-8 w-8 text-[#ed7655]' />
            <h2 class='editorial-heading mt-5 max-w-3xl text-4xl font-semibold md:text-5xl'>
              Continue with the public evidence library.
            </h2>
            <p class='mt-5 max-w-2xl leading-8 text-[#c9d9d2]'>
              Browse artifact-level reports, privacy-reviewed screenshots, stable
              indicators, limitations, and remediation context behind the field work.
            </p>
          </div>
          <div class='lg:justify-self-end'>
            <a
              href='/malware-research/'
              class='group inline-flex items-center gap-2 rounded-full bg-[#ed7655] px-6 py-3.5 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-[#d96142]'>
              Browse malware research
              <ArrowRight class='h-4 w-4 transition group-hover:translate-x-1' />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</NewLayout>

<style>
  .books-hero {
    background:
      radial-gradient(circle at 24% 20%, rgba(237, 118, 85, 0.09), transparent 28%),
      radial-gradient(circle at 78% 44%, rgba(31, 107, 85, 0.13), transparent 32%),
      linear-gradient(135deg, #f7f4ed, #fffdf8 55%, #eaf2ed);
  }

  .books-grid {
    opacity: 0.46;
    background-image:
      linear-gradient(rgba(31, 107, 85, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(31, 107, 85, 0.055) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 95%);
  }

  .book-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
  }

  .book-cover-stage {
    background:
      radial-gradient(circle at 50% 28%, rgba(255, 253, 248, 0.95), transparent 36%),
      linear-gradient(145deg, #dcece5, #eef4ef);
  }

  .book-card {
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .book-card:hover {
    transform: translateY(-4px);
    border-color: #b8cac1;
    box-shadow: 0 22px 45px rgba(23, 53, 44, 0.1);
  }

  .research-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.2;
    background-image:
      linear-gradient(rgba(142, 208, 181, 0.17) 1px, transparent 1px),
      linear-gradient(90deg, rgba(142, 208, 181, 0.17) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(90deg, transparent, black);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-card,
    .book-card img {
      transition: none;
    }
  }
</style>
