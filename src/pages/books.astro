---
import {
  ArrowRight,
  BookOpen,
  ExternalLink,
  Microscope,
} from '@lucide/astro';

import NewLayout from '../layouts/NewLayout.astro';
import { books } from '../data/books';

const url = 'https://www.mdpabel.com/books/';
const title = 'WordPress Security Books by MD Pabel';
const description =
  'Browse practical WordPress security books by MD Pabel, built from real malware investigations, cleanup cases, recovery work, and retained evidence.';

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    mainEntity: { '@id': `${url}#books` },
    breadcrumb: { '@id': `${url}#breadcrumb` },
  },
  {
    '@type': 'ItemList',
    '@id': `${url}#books`,
    name: 'WordPress security books by MD Pabel',
    numberOfItems: books.length,
    itemListElement: books.map((book, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Book',
        name: `${book.title} ${book.subtitle}`,
        url: new URL(book.details, url).href,
        sameAs: book.stores.map((store) => store.href),
        author: {
          '@type': 'Person',
          '@id': 'https://www.mdpabel.com/about/#person',
          name: 'MD Pabel',
        },
        numberOfPages: book.numberOfPages,
        bookFormat: 'https://schema.org/EBook',
        inLanguage: 'en',
        offers: {
          '@type': 'Offer',
          price: book.price.replace('$', ''),
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: book.checkoutUrl,
        },
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.mdpabel.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Books',
        item: url,
      },
    ],
  },
];
---

<NewLayout
  {title}
  {description}
  path={url}
  image='/images/book/wordpress-malware-removal-book-social.png'
  {schema}>
  <section class='relative py-16 md:py-24 border-[#d7ddd7] border-b overflow-hidden books-hero'>
    <div class='absolute inset-0 books-grid pointer-events-none'></div>
    <div class='relative new-shell'>
      <div class='max-w-4xl'>
        <div class='inline-flex items-center gap-2 bg-white/75 shadow-sm backdrop-blur px-3.5 py-2 border border-[#1f6b55]/15 rounded-full font-extrabold text-[#1f6b55] text-[11px] uppercase tracking-[0.14em]'>
          <BookOpen class='w-3.5 h-3.5' />
          Books by MD Pabel
        </div>
        <h1 class='mt-6 max-w-4xl font-semibold editorial-heading'>
          Practical WordPress security books for real incidents.
        </h1>
        <p class='mt-6 max-w-3xl text-[#52665f] text-lg md:text-xl leading-8'>
          A growing catalog of field guides and focused case studies for investigating,
          cleaning, recovering, and verifying compromised WordPress websites.
        </p>
      </div>
    </div>
  </section>

  <section aria-labelledby='published-books-title' class='py-16 md:py-24'>
    <div class='new-shell'>
      <div class='flex sm:flex-row flex-col sm:justify-between sm:items-end gap-4 pb-7 border-[#d7ddd7] border-b'>
        <div>
          <p class='font-extrabold text-[#b84e31] text-xs uppercase tracking-[0.16em]'>
            The catalog
          </p>
          <h2 id='published-books-title' class='mt-3 font-semibold text-3xl md:text-4xl editorial-heading'>
            Published books
          </h2>
        </div>
        <span class='bg-[#dcece5] px-4 py-2 rounded-full w-fit font-extrabold text-[#1f6b55] text-xs'>
          {books.length} {books.length === 1 ? 'title' : 'titles'}
        </span>
      </div>

      <div class='gap-7 book-catalog-grid mt-10'>
        {
          books.map((book) => (
            <article class='flex flex-col bg-[#fffdf8] shadow-sm border border-[#d7ddd7] rounded-[2rem] min-w-0 overflow-hidden book-card'>
              <a
                href={book.details}
                class='group place-items-center grid p-8 min-h-80 overflow-hidden book-cover-stage'
                aria-label={`Explore ${book.title} ${book.subtitle}`}>
                <img
                  src={book.cover}
                  alt={book.alt}
                  loading='lazy'
                  class='shadow-[#17352c]/25 shadow-2xl rounded-sm w-auto max-w-[210px] h-auto max-h-[310px] group-hover:rotate-[-1deg] transition group-hover:-translate-y-1 duration-300'
                />
              </a>

              <div class='flex flex-col flex-1 p-6 md:p-8'>
                <p class='font-extrabold text-[#b84e31] text-[10px] uppercase tracking-[0.16em]'>
                  {book.badge}
                </p>
                <h2 class='mt-3 font-semibold text-3xl leading-[1.04] editorial-heading'>
                  {book.title}
                </h2>
                <p class='mt-2 font-bold text-[#1f6b55] text-sm leading-6'>{book.subtitle}</p>
                <p class='mt-5 text-[#52665f] text-sm leading-7'>{book.description}</p>

                <div class='flex flex-wrap gap-2 mt-5'>
                  {book.metrics.map((metric) => (
                    <span class='bg-[#f7f4ed] px-3 py-1.5 border border-[#cdd8d2] rounded-full font-extrabold text-[#40574f] text-[11px]'>
                      {metric}
                    </span>
                  ))}
                </div>

                <p class='mt-6 pl-4 border-[#ed7655] border-l-2 text-[#52665f] text-xs leading-6'>
                  <strong class='text-[#17352c]'>Best for:</strong> {book.bestFor}
                </p>

                <div class='mt-auto pt-7'>
                  <div class='flex flex-wrap items-center gap-3'>
                    <a
                      href={book.checkoutUrl}
                      target='_blank'
                      rel='noopener'
                      class='group inline-flex items-center gap-2 bg-[#1f6b55] hover:bg-[#164a3c] px-5 py-3 rounded-full font-extrabold text-white text-xs transition hover:-translate-y-0.5'
                      data-umami-event='book-checkout-started'
                      data-umami-event-product={`${book.title} ${book.subtitle}`}
                      data-umami-event-price={book.price.replace('$', '')}
                      data-umami-event-currency='USD'
                      data-umami-event-placement='catalog'>
                      Buy now · {book.price}
                      <ArrowRight class='w-4 h-4 transition group-hover:translate-x-0.5' />
                    </a>
                    <a
                      href={book.details}
                      class='font-extrabold text-[#1f6b55] hover:text-[#164a3c] text-xs transition'>
                      View details
                    </a>
                    <a
                      href={`${book.details}#gift-copies`}
                      class='font-extrabold text-[#b84e31] hover:text-[#8f3c28] text-xs transition'
                      data-umami-event='book-gift-started'
                      data-umami-event-product={`${book.title} ${book.subtitle}`}
                      data-umami-event-placement='catalog'>
                      Buy multiple or gift
                    </a>
                  </div>
                  <p class='mt-3 text-xs font-bold text-[#b84e31]'>
                    Launch offer: 70% off automatically with code LAUNCH70.
                  </p>
                  <div class='flex flex-wrap gap-x-4 gap-y-2 mt-4'>
                    {book.stores.map((store) => (
                      <a
                        href={store.href}
                        target='_blank'
                        rel='noopener'
                        class='inline-flex items-center gap-1.5 font-extrabold text-[#52665f] hover:text-[#b84e31] text-xs transition'>
                        {store.label} <ExternalLink class='w-3.5 h-3.5' />
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class='pb-16 md:pb-24'>
    <div class='new-shell'>
      <div class='relative bg-[#17352c] p-8 md:p-12 rounded-[2rem] overflow-hidden text-white research-panel'>
        <div class='relative items-center gap-8 grid lg:grid-cols-[1.2fr_0.8fr]'>
          <div>
            <Microscope class='w-8 h-8 text-[#ed7655]' />
            <h2 class='mt-5 max-w-3xl font-semibold text-4xl md:text-5xl editorial-heading'>
              Continue with the public evidence library.
            </h2>
            <p class='mt-5 max-w-2xl text-[#c9d9d2] leading-8'>
              Browse artifact-level reports, privacy-reviewed screenshots, stable
              indicators, limitations, and remediation context behind the field work.
            </p>
          </div>
          <div class='lg:justify-self-end'>
            <a
              href='/malware-research/'
              class='group inline-flex items-center gap-2 bg-[#ed7655] hover:bg-[#d96142] px-6 py-3.5 rounded-full font-extrabold text-white text-sm transition hover:-translate-y-0.5'>
              Browse malware research
              <ArrowRight class='w-4 h-4 transition group-hover:translate-x-1' />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</NewLayout>

<style>
  .books-hero {
    background:
      radial-gradient(circle at 24% 20%, rgba(237, 118, 85, 0.09), transparent 28%),
      radial-gradient(circle at 78% 44%, rgba(31, 107, 85, 0.13), transparent 32%),
      linear-gradient(135deg, #f7f4ed, #fffdf8 55%, #eaf2ed);
  }

  .books-grid {
    opacity: 0.46;
    background-image:
      linear-gradient(rgba(31, 107, 85, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(31, 107, 85, 0.055) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, black, transparent 95%);
  }

  .book-catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
  }

  .book-cover-stage {
    background:
      radial-gradient(circle at 50% 28%, rgba(255, 253, 248, 0.95), transparent 36%),
      linear-gradient(145deg, #dcece5, #eef4ef);
  }

  .book-card {
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .book-card:hover {
    transform: translateY(-4px);
    border-color: #b8cac1;
    box-shadow: 0 22px 45px rgba(23, 53, 44, 0.1);
  }

  .research-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.2;
    background-image:
      linear-gradient(rgba(142, 208, 181, 0.17) 1px, transparent 1px),
      linear-gradient(90deg, rgba(142, 208, 181, 0.17) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(90deg, transparent, black);
  }

  @media (prefers-reduced-motion: reduce) {
    .book-card,
    .book-card img {
      transition: none;
    }
  }
</style>
