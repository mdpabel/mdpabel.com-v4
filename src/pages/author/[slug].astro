---
import NewLayout from '../../layouts/NewLayout.astro';
import Breadcrumbs from '../../components/new/Breadcrumbs.astro';
import { wordpress } from '../../lib/wordpress';
export async function getStaticPaths(){const sets=await Promise.all(['posts','guide','case-study','malware-log'].map(postType=>wordpress.getAllPosts({postType}).catch(()=>[])));const labels=['Blog','Guide','Case Study','Malware Log'];const posts=sets.flatMap((s,i)=>s.map(p=>({...p,typeLabel:labels[i],root:['blog','guides','case-studies','malware-log'][i]}))).sort((a,b)=>+new Date(b.date)-+new Date(a.date));return [{params:{slug:'mdpabel'},props:{posts}}];}
const {posts}=Astro.props;const path='/author/mdpabel/';const description='Articles, security guides, forensic case studies, and malware research published by MD Pabel, an independent WordPress security specialist.';const schema=[{'@type':'ProfilePage',name:'MD Pabel author archive',description,url:`https://www.mdpabel.com${path}`,mainEntity:{'@type':'Person',name:'MD Pabel',url:'https://www.mdpabel.com/about/',jobTitle:'WordPress Security Specialist'}},{'@type':'ItemList',itemListElement:posts.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.title.replace(/<[^>]+>/g,''),url:`https://www.mdpabel.com/${p.root}/${p.slug}/`}))}];
---
<NewLayout title='MD Pabel: WordPress Security Author' description={description} path={path} schema={schema}><section class='border-b border-[#d7ddd7] py-14 md:py-20'><div class='new-shell'><Breadcrumbs items={[{label:'Author'},{label:'MD Pabel'}]}/><div class='mt-9 grid gap-7 md:grid-cols-[120px_1fr] md:items-center'><img src='https://secure.gravatar.com/avatar/b6b48a60efe9dc8cd04d4a7e5c9b22cafd47332f65a407ce270e8ad7f8843372?s=240' alt='MD Pabel' width='120' height='120' class='rounded-full border-4 border-white shadow-lg'/><div><p class='text-xs font-extrabold uppercase tracking-[.16em] text-[#1f6b55]'>Author and practitioner</p><h1 class='editorial-heading mt-3 font-semibold'>MD Pabel</h1><p class='mt-4 max-w-3xl leading-7 text-[#52665f]'>{description} <a href='/about/' class='font-bold text-[#1f6b55] underline'>Review experience and methods.</a></p></div></div></div></section><section class='py-16'><div class='new-shell'><h2 class='editorial-heading text-4xl font-semibold'>Latest contributions</h2>{posts.length?<div class='mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3'>{posts.map(p=><article class='rounded-2xl border border-[#d7ddd7] bg-[#fffdf8] p-6'><span class='text-[10px] font-bold uppercase tracking-wider text-[#b74e32]'>{p.typeLabel}</span><h3 class='editorial-heading mt-4 text-2xl font-semibold leading-tight'><a href={`/${p.root}/${p.slug}/`} set:html={p.title}/></h3><time class='mt-5 block text-xs text-[#788780]'>{new Date(p.date).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></article>)}</div>:<p class='mt-6 rounded-xl border border-[#d7ddd7] bg-[#fffdf8] p-6 text-[#52665f]'>Published contributions will appear when the content source is available.</p>}</div></section></NewLayout>
