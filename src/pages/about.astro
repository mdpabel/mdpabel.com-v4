---
import { Image } from 'astro:assets';
import {
  ArrowRight,
  ArrowUpRight,
  BadgeCheck,
  Braces,
  Check,
  Search,
  ShieldCheck,
} from '@lucide/astro';
import NewLayout from '../layouts/NewLayout.astro';
import Breadcrumbs from '../components/new/Breadcrumbs.astro';
import portrait from '../assets/my-img.png';

const title = 'About MD Pabel | WordPress Security Specialist Since 2018';
const description =
  'Meet MD Pabel, an independent WordPress security specialist with 4,500+ hacked-site cleanups, development experience, and first-hand malware research since 2018.';
const url = 'https://www.mdpabel.com/about/';
const personId = `${url}#person`;
const schema = [
  {
    '@type': 'ProfilePage',
    '@id': `${url}#profilepage`,
    url,
    name: title,
    description,
    mainEntity: { '@id': personId },
    dateModified: '2026-07-17',
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'MD Pabel',
    url,
    image: 'https://www.mdpabel.com/md-pabel.png',
    jobTitle: 'WordPress Security Specialist and Web Developer',
    description:
      'Independent WordPress security specialist with first-hand experience across more than 4,500 hacked website cleanups since 2018.',
    email: 'support@mdpabel.com',
    sameAs: [
      'https://www.linkedin.com/in/mdpabe1/',
      'https://github.com/mdpabel',
      'https://find-and-update.company-information.service.gov.uk/company/15939565/officers',
    ],
    knowsAbout: [
      'WordPress malware removal',
      'Hacked website recovery',
      'WordPress security',
      'Blacklist removal',
      'WordPress development',
      'Next.js development',
      'Astro development',
      'Web application security',
    ],
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://www.mdpabel.com/',
      },
      { '@type': 'ListItem', position: 2, name: 'About MD Pabel', item: url },
    ],
  },
];

const principles = [
  [
    'Evidence before assumptions',
    'I reproduce symptoms, inspect the affected layers, and use logs and file history where available before deciding what needs to change.',
  ],
  [
    'Manual review where tools stop',
    'Scanners help surface signals, but unfamiliar backdoors, conditional redirects, database payloads, and business-specific code need human judgment.',
  ],
  [
    'Preserve what belongs',
    'Security cleanup should not destroy orders, products, content, custom functionality, or the evidence needed to understand an incident.',
  ],
  [
    'Explain the useful truth',
    'Clients receive the important finding and next step in plain language—not a theatrical list of every file touched.',
  ],
];
---

<NewLayout
  title={title}
  description={description}
  path='/about/'
  image='/md-pabel.png'
  schema={schema}>
  <section class='py-16 md:py-24 border-[#d7ddd7] border-b'>
    <div class='new-shell'>
      <Breadcrumbs items={[{ label: 'About' }]} /><div
        class='items-center gap-14 lg:gap-24 grid lg:grid-cols-[1fr_0.75fr] mt-10'>
        <div>
          <p
            class='mb-4 font-extrabold text-[#1f6b55] text-xs uppercase tracking-[0.16em]'>
            The person behind the work
          </p><h1
            class='font-semibold text-5xl md:text-7xl leading-[0.96] editorial-heading'>
            Security work is easier when you know who is accountable.
          </h1><p class='mt-7 max-w-3xl text-[#52665f] text-lg leading-8'>
            I’m MD Pabel, an independent WordPress security specialist and web
            developer. Since 2018, I have helped website owners and agencies
            investigate, clean, recover, and improve thousands of WordPress
            websites.
          </p><div class='flex flex-wrap gap-4 mt-8'>
            <a
              href='/hire-me/'
              class='inline-flex items-center gap-2 bg-[#1f6b55] px-6 py-3.5 rounded-full font-bold text-white text-sm'
              >Work with me <ArrowRight class='w-4 h-4' /></a
            ><a
              href='/case-studies/'
              class='inline-flex items-center gap-2 pb-1 border-[#aebbb5] border-b font-bold text-sm'
              >See recovery evidence <ArrowUpRight class='w-4 h-4' /></a
            >
          </div>
        </div><div class='relative mx-auto w-full max-w-md'>
          <div
            class='-top-5 -right-5 absolute bg-[#dcece5] rounded-[44%_10%_44%_10%] w-full h-full rotate-3'>
          </div><div
            class='relative bg-[#dcece5] shadow-[#17352c]/15 shadow-2xl border-[#fffdf8] border-[8px] rounded-[44%_10%_44%_10%] overflow-hidden'>
            <Image
              src={portrait}
              alt='MD Pabel, WordPress security specialist'
              width={520}
              height={640}
              format='avif'
              quality='high'
              class='w-full h-full object-cover'
            /><div
              class='right-4 bottom-4 left-4 absolute flex items-center gap-3 bg-[#fffdf8]/90 backdrop-blur p-3 border border-white/60 rounded-xl'>
              <span
                class='place-items-center grid bg-[#1f6b55] rounded-full w-10 h-10 text-white'
                ><BadgeCheck class='w-5 h-5' /></span
              ><span class='text-[#52665f] text-xs'
                ><strong class='block text-[#17352c] text-sm'
                  >Independent specialist</strong
                >Direct communication from start to finish</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class='bg-[#17352c] py-8 text-white'>
    <div class='gap-6 grid sm:grid-cols-2 lg:grid-cols-4 text-center new-shell'>
      <div>
        <strong class='text-4xl editorial-heading'>4,500+</strong><span
          class='block mt-1 text-[#bdd4ca] text-xs'>hacked-site cleanups</span
        >
      </div><div>
        <strong class='text-4xl editorial-heading'>2018</strong><span
          class='block mt-1 text-[#bdd4ca] text-xs'
          >working in web security since</span
        >
      </div><div>
        <strong class='text-4xl editorial-heading'>2,300+</strong><span
          class='block mt-1 text-[#bdd4ca] text-xs'>clients served</span
        >
      </div><div>
        <strong class='text-4xl editorial-heading'>Worldwide</strong><span
          class='block mt-1 text-[#bdd4ca] text-xs'>remote client support</span
        >
      </div>
    </div>
  </section>
  <section class='py-20 md:py-28'>
    <div class='gap-14 lg:gap-24 grid lg:grid-cols-[0.75fr_1.25fr] new-shell'>
      <div>
        <p
          class='mb-3 font-extrabold text-[#1f6b55] text-xs uppercase tracking-[0.15em]'>
          First-hand experience
        </p><h2 class='font-semibold text-4xl md:text-5xl editorial-heading'>
          What the numbers actually represent.
        </h2>
      </div><div class='space-y-6 text-[#52665f] text-base leading-8'>
        <p>
          The 4,500+ figure represents practical cleanup work across freelance
          platforms, agency partnerships, direct website owners, referrals,
          eCommerce stores, content sites, and emergency hosting-recovery jobs.
          It is not a scanner count or a number of automated checks.
        </p><p>
          Those incidents have included hidden PHP backdoors, redirect malware,
          fake CAPTCHA pages, Japanese keyword hacks, database injections, fake
          plugins, malicious scheduled tasks, hosting suspensions, browser
          warnings, and reinfections that survived earlier cleanups.
        </p><p>
          I also build and maintain websites. That development background
          matters during security work because not every unfamiliar file is
          malicious, and a cleanup must preserve the custom behavior a business
          depends on.
        </p>
      </div>
    </div>
  </section>
  <section class='bg-[#fffdf8] py-20 md:py-28'>
    <div class='new-shell'>
      <div class='max-w-3xl'>
        <p
          class='mb-3 font-extrabold text-[#1f6b55] text-xs uppercase tracking-[0.15em]'>
          Working principles
        </p><h2 class='font-semibold text-4xl md:text-6xl editorial-heading'>
          How I approach technical work.
        </h2>
      </div><div
        class='gap-px grid md:grid-cols-2 bg-[#d7ddd7] mt-12 border border-[#d7ddd7] rounded-2xl overflow-hidden'>
        {
          principles.map(([heading, copy], index) => (
            <article class='bg-[#f7f4ed] p-7'>
              <>
                <span class='text-[#ed7655] text-sm editorial-heading'>
                  0{index + 1}
                </span>
                <h3 class='mt-8 font-semibold text-2xl editorial-heading'>
                  {heading}
                </h3>
                <p class='mt-3 text-[#52665f] text-sm leading-7'>{copy}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class='py-20 md:py-28'>
    <div class='gap-14 lg:gap-24 grid lg:grid-cols-[0.8fr_1.2fr] new-shell'>
      <div>
        <h2 class='font-semibold text-4xl md:text-5xl editorial-heading'>
          Areas of practice.
        </h2><p class='mt-5 text-[#52665f] text-sm leading-7'>
          The site is focused intentionally: WordPress security, reliable
          website ownership, and modern web development.
        </p>
      </div><div class='gap-4 grid sm:grid-cols-3'>
        <a
          href='/wordpress-malware-removal/'
          class='bg-[#fffdf8] p-6 border border-[#d7ddd7] rounded-2xl'
          ><ShieldCheck class='w-6 h-6 text-[#1f6b55]' /><h3
            class='mt-7 font-semibold text-2xl editorial-heading'>
            Security
          </h3><p class='mt-3 text-[#52665f] text-xs leading-6'>
            Malware cleanup, incident recovery, hardening, and blacklist
            support.
          </p></a
        ><a
          href='/wordpress-maintenance/'
          class='bg-[#fffdf8] p-6 border border-[#d7ddd7] rounded-2xl'
          ><Search class='w-6 h-6 text-[#1f6b55]' /><h3
            class='mt-7 font-semibold text-2xl editorial-heading'>
            Maintenance
          </h3><p class='mt-3 text-[#52665f] text-xs leading-6'>
            Updates, backups, monitoring, performance, and technical support.
          </p></a
        ><a
          href='/website-development/'
          class='bg-[#fffdf8] p-6 border border-[#d7ddd7] rounded-2xl'
          ><Braces class='w-6 h-6 text-[#1f6b55]' /><h3
            class='mt-7 font-semibold text-2xl editorial-heading'>
            Development
          </h3><p class='mt-3 text-[#52665f] text-xs leading-6'>
            WordPress, Next.js, Astro, integrations, and AI-assisted products.
          </p></a
        >
      </div>
    </div>
  </section>
  <section class='pb-24'>
    <div class='bg-[#1f6b55] p-8 md:p-12 rounded-3xl text-white new-shell'>
      <div class='items-center gap-8 grid md:grid-cols-[1fr_auto]'>
        <div>
          <p
            class='font-bold text-[#b9d8cc] text-xs uppercase tracking-[0.14em]'>
            Need direct help?
          </p><h2 class='mt-3 font-semibold text-4xl editorial-heading'>
            Tell me what is happening with your website.
          </h2>
        </div><a
          href='/hire-me/'
          class='inline-flex items-center gap-2 bg-[#ed7655] px-6 py-3 rounded-full w-fit font-bold'
          >Start a conversation <ArrowUpRight class='w-4 h-4' /></a
        >
      </div>
    </div>
  </section>
</NewLayout>
