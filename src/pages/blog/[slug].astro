---
import ArticlePage from '../../components/new/ArticlePage.astro';
import { wordpress } from '../../lib/wordpress';

export async function getStaticPaths() {
  const posts = await wordpress.getAllPosts({ postType: 'posts' });
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, relatedPosts: posts.filter((item) => item.id !== post.id && item.categories.some((category) => post.categories.some((current) => current.id === category.id))).slice(0, 3) } }));
}
const { post, relatedPosts } = Astro.props;
---
<ArticlePage post={post} relatedPosts={relatedPosts} rootSlug='blog' label='Blog' kind='blog' />
