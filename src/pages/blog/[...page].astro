---
import ArchivePage from '../../components/new/ArchivePage.astro';
import { wordpress } from '../../lib/wordpress';

export async function getStaticPaths() {
  const perPage = 10;
  const allPosts = await wordpress.getAllPosts({ postType: 'posts' });
  const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));
  return Array.from({ length: totalPages }, (_, index) => ({ params: { page: index === 0 ? undefined : String(index + 1) }, props: { posts: allPosts.slice(index * perPage, (index + 1) * perPage), totalPages, currentPage: index + 1 } }));
}
const { posts, totalPages, currentPage } = Astro.props;
const seoTitle = currentPage === 1 ? 'WordPress Security Blog | Malware, Errors & Recovery' : `WordPress Security Blog — Page ${currentPage} | MD Pabel`;
---
<ArchivePage posts={posts} totalPages={totalPages} currentPage={currentPage} rootSlug='blog' label='Blog' title='Practical WordPress security insights.' description='Field-informed articles about malware behavior, hacked-site recovery, WordPress errors, maintenance, development, and safer website ownership.' seoTitle={seoTitle} />
